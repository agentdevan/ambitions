{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/source-atlas/schemas/scenario-spec.schema.json",
  "title": "ScenarioSpec",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "description",
    "dimensions",
    "user_intent",
    "hidden_context",
    "available_time",
    "protected_time_context",
    "energy_context",
    "dependency_context",
    "expected_bad_recommendation",
    "expected_ambitions_behavior",
    "required_source_knowledge",
    "source_quality_expectation",
    "freshness_expectation",
    "privacy_boundary",
    "local_only_requirement",
    "start_here_receipt_expectation",
    "reality_meridian_expectation",
    "closure_expectation",
    "recovery_expectation",
    "replay_expectation",
    "validation_expectation",
    "should_promote_to_fixture",
    "should_promote_to_source_pack",
    "generated_derivative_notice",
    "cannot_satisfy_proof_alone",
    "created_by",
    "created_at",
    "input_hash",
    "recipe_id",
    "generation_run_id"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^scenario\\."},
    "version": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "dimensions": {
      "type": "object",
      "required": [
        "product_object",
        "life_domain",
        "intent_shape",
        "time_reality",
        "capacity_constraint",
        "disruption_type",
        "evidence_quality",
        "source_freshness",
        "closure_state",
        "recovery_path",
        "recommendation_failure_mode",
        "start_here_receipt_risk",
        "privacy_sensitivity",
        "runtime_proof_need",
        "severity"
      ],
      "additionalProperties": false
    },
    "generated_derivative_notice": {"const": true},
    "cannot_satisfy_proof_alone": {"const": true},
    "local_only_requirement": {"type": "string", "minLength": 1},
    "privacy_boundary": {"type": "string", "minLength": 1},
    "validation_expectation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
