{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/schemas/senior-review-finding.schema.json",
  "title": "Ambitions Senior Review Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "source_artifact",
    "severity",
    "failure_class",
    "affected_file",
    "affected_layer",
    "evidence",
    "scg_repair_train_owner",
    "required_proof",
    "status"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^SCG-[0-9]{3,}-[0-9]{3,}$"
    },
    "source_artifact": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": ["B0", "B1", "B2", "B3", "B4"]
    },
    "failure_class": {
      "type": "string",
      "enum": [
        "canon-drift",
        "wrong-owner",
        "fake-runtime",
        "dead-control",
        "proof-gap",
        "accessibility-gap",
        "visual-product-gap",
        "privacy-boundary-risk",
        "test-theater",
        "over-broad-slice",
        "maintainability-debt"
      ]
    },
    "affected_file": {
      "type": "string",
      "minLength": 1
    },
    "affected_layer": {
      "type": "string",
      "minLength": 1
    },
    "affected_flow": {
      "type": "string"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "linear_issue": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]+-[0-9]+$"
    },
    "duplicate_or_related": {
      "type": ["string", "null"]
    },
    "scg_repair_train_owner": {
      "type": "string",
      "minLength": 1
    },
    "required_proof": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["open", "duplicate", "accepted-yellow", "blocked", "closed-with-proof"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
