{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/schemas/ownership-map.schema.json",
  "title": "Ambitions SCG Ownership Map",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "version",
    "status",
    "issue",
    "baseline_sha",
    "owners"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "retired"
      ]
    },
    "issue": {
      "type": "string"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "layer_name",
          "canonical_path",
          "owned_responsibilities",
          "allowed_imports",
          "forbidden_imports",
          "allowed_file_patterns",
          "forbidden_file_patterns",
          "production_code_change_posture",
          "review_risk_notes",
          "escalation_rule_for_unknown_ownership"
        ],
        "additionalProperties": true
      }
    }
  }
}
