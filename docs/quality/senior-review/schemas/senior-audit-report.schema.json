{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/schemas/senior-audit-report.schema.json",
  "title": "Ambitions Senior Audit Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue",
    "baseline_sha",
    "head_sha",
    "status",
    "claim",
    "commands",
    "artifacts",
    "findings",
    "non_claims"
  ],
  "properties": {
    "issue": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]+$"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["Source Green", "Runtime Green", "Interaction Green", "Ready for Visual Review", "Yellow", "Red"]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_owner": {
      "type": "string"
    },
    "proof_owner": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
