{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/schemas/file_inventory.schema.json",
  "title": "Ambitions SCG File Inventory",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "version",
    "status",
    "issue",
    "branch",
    "commit_sha",
    "layer_taxonomy",
    "entries",
    "summary"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "layer_taxonomy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "layer",
          "file_type",
          "line_count",
          "imports",
          "types",
          "public_internal_types",
          "current_owner",
          "expected_owner",
          "target_membership",
          "test_coverage",
          "risk_level",
          "status",
          "file_hash",
          "last_reviewed_sha",
          "source_evidence"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "types": {
            "type": "array"
          },
          "current_owner": {
            "type": "string"
          },
          "expected_owner": {
            "type": "string"
          },
          "target_membership": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_coverage": {
            "type": "object"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "Green",
              "Yellow",
              "Red"
            ]
          },
          "status": {
            "type": "string"
          },
          "file_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_reviewed_sha": {
            "type": "string"
          },
          "source_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "public_internal_types": {
            "type": "array"
          }
        }
      }
    },
    "summary": {
      "type": "object"
    }
  }
}
