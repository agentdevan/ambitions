  "commands": [
    {
      "id": "m09.git.diff.check",
      "area": "privacy-security",
      "availability": "available",
      "command": "git diff --check",
      "proofExpectation": "Whitespace and patch integrity check for tracked diff."
    },
    {
      "id": "m09.local.pr.review",
      "area": "privacy-security",
      "availability": "available",
      "command": "bash scripts/ci/ambitions-pr-review-local.sh --continue",
      "proofExpectation": "Local PR review stack output with pass/fail counts."
    },
    {
      "id": "m09.green.standard.audit",
      "area": "privacy-security",
      "availability": "available",
      "command": "python3 scripts/ambitions-green-standard-audit.py",
      "proofExpectation": "Green-standard source audit output."
    },
    {
      "id": "m09.boundary.audit",
      "area": "boundary",
