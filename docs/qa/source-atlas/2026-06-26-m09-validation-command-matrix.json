{
  "schemaVersion": 1,
  "kind": "ambitions.sourceAtlas.m09.validationCommandMatrix",
  "status": "canonical-m09-local-validation-matrix",
  "nonClaims": [
    "does not claim release readiness",
    "does not claim production R2 upload",
    "does not close known issues",
    "does not close the Source Atlas project"
