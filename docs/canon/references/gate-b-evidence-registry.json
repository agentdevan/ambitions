  "payload_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "evidence_id",
      "check_identity",
      "semantic",
      "source_sha",
      "source_tree_sha",
      "input_paths",
      "input_sha256",
      "observation",
      "validator_id"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "evidence_id": {
        "type": "string",
        "minLength": 1
      },
      "check_identity": {
        "type": "string",
        "minLength": 1
      },
      "semantic": {
        "type": "string",
        "minLength": 1
      },
      "source_sha": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "source_tree_sha": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "input_paths": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "input_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "observation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "subject_count",
          "subject_sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "subject_count": {
            "type": "integer",
            "minimum": 1
          },
          "subject_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "validator_id": {
        "type": "string",
        "minLength": 1
      }
    }
  },
