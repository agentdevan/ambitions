{
  "$id": "https://ambitions.local/canon/schemas/approval-attestation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Cryptographically verified, platform-authenticated, exact-scope, one-time approval projection.",
  "properties": {
    "app_id": {"minLength": 1, "type": "string"},
    "approval_policy_id": {"minLength": 1, "type": "string"},
    "approval_policy_revision": {"minLength": 1, "type": "string"},
    "approved_scope": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "attestation_id": {"minLength": 1, "type": "string"},
    "attestation_origin": {"const": "platform-authenticated", "type": "string"},
    "authenticated_principal": {"minLength": 1, "type": "string"},
    "break_glass": {"type": "boolean"},
    "check_identity": {"minLength": 1, "type": "string"},
    "command_manifest_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "consumed": {"type": "boolean"},
    "expires_at_epoch": {"minimum": 1, "type": "integer"},
    "event_projection_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "incident_id": {"type": ["string", "null"]},
    "intake_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "intake_id": {"minLength": 1, "type": "string"},
    "integration_id": {"minLength": 1, "type": "string"},
    "merge_base_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
    "one_time_use_nonce": {"minLength": 1, "type": "string"},
    "policy_revision": {"minLength": 1, "type": "string"},
    "post_action_review_required": {"type": "boolean"},
    "pull_request_number": {"minimum": 1, "type": "integer"},
    "repository_full_name": {"minLength": 1, "type": "string"},
    "repository_id": {"minLength": 1, "type": "string"},
    "revoked": {"type": "boolean"},
    "rollback_ref": {"type": ["string", "null"]},
    "schema_version": {"const": 1, "type": "integer"},
    "signature_algorithm": {"const": "rsa-pkcs1v15-sha256", "type": "string"},
    "signature_base64url": {"pattern": "^[A-Za-z0-9_-]+$", "type": "string"},
    "task_id": {"minLength": 1, "type": "string"},
    "trust_anchor_id": {"minLength": 1, "type": "string"},
    "trust_anchor_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "trusted_base_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
    "trusted_head_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
    "verification_epoch": {"minimum": 1, "type": "integer"},
    "workflow_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "workflow_run_attempt": {"minimum": 1, "type": "integer"},
    "workflow_run_id": {"minimum": 1, "type": "integer"},
    "consumption_generation": {"minimum": 1, "type": "integer"},
    "workflow_path": {"minLength": 1, "type": "string"},
    "workflow_ref": {"minLength": 1, "type": "string"}
  },
  "required": [
    "schema_version", "attestation_id", "attestation_origin", "repository_id",
    "repository_full_name", "pull_request_number", "task_id", "intake_id",
    "trusted_base_sha", "trusted_head_sha", "merge_base_sha", "intake_digest",
    "policy_revision", "command_manifest_digest", "workflow_path", "workflow_ref",
    "workflow_digest", "workflow_run_id", "workflow_run_attempt",
    "event_projection_digest", "consumption_generation",
    "check_identity", "integration_id", "app_id",
    "approval_policy_id", "approval_policy_revision", "authenticated_principal",
    "approved_scope", "one_time_use_nonce", "verification_epoch", "consumed", "expires_at_epoch",
    "revoked", "break_glass", "incident_id", "rollback_ref", "post_action_review_required",
    "trust_anchor_id", "trust_anchor_sha256", "signature_algorithm",
    "signature_base64url"
  ],
  "title": "Ambitions Approval Attestation",
  "type": "object"
}
