{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/canon/ux-blueprint.schema.json",
  "title": "Ambitions visual-rebaseline UX blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_state",
    "blueprint_id",
    "canon_content_sha",
    "canon_revision",
    "claim_ceiling",
    "cross_cutting",
    "journeys",
    "legacy_figma_policy",
    "object_boundaries",
    "primary_linear_v3",
    "requirement_dispositions",
    "schema_version",
    "screens",
    "sensitive_exposure_channels",
    "setup_contract",
    "specification_gaps",
    "source_documents",
    "source_sha",
    "state_models",
    "status",
    "title"
  ],
  "properties": {
    "authority_state": {"const": "shadow"},
    "blueprint_id": {"type": "string", "const": "AMB-UX-BLUEPRINT-REBASELINE-001"},
    "canon_content_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canon_revision": {"type": "integer", "minimum": 1},
    "claim_ceiling": {"const": "Visual design input only; no source, runtime, rendered-app, accessibility, device, privacy/legal, distribution, or release claim."},
    "cross_cutting": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/crossCutting"}
    },
    "journeys": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/journey"}
    },
    "legacy_figma_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_roles", "destructive_actions", "rejected_as_final_target"],
      "properties": {
        "allowed_roles": {
          "type": "array",
          "const": ["exploration", "failure_evidence", "implementation_history", "provenance", "unique_content_source"]
        },
        "destructive_actions": {"const": "withheld_gate_c"},
        "rejected_as_final_target": {"const": true}
      }
    },
    "object_boundaries": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/objectBoundary"}
    },
    "primary_linear_v3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "document_id", "title"],
      "properties": {
        "disposition": {"const": "migration_corpus_unchanged"},
        "document_id": {"const": "96b93346-271d-46fc-beab-43ff7e286b5d"},
        "title": {"const": "B1A-D01R — Ambitions Product / IA / Object Model Full Design Spec v3 — Canonical"}
      }
    },
    "requirement_dispositions": {
      "type": "array",
      "minItems": 460,
      "maxItems": 460,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/requirementDisposition"}
    },
    "schema_version": {"const": 1},
    "screens": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/screen"}
    },
    "sensitive_exposure_channels": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sensitiveExposure"}
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceDocument"}
    },
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "setup_contract": {"$ref": "#/$defs/setupContract"},
    "state_models": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stateModel"}
    },
    "specification_gaps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 0,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/specificationGap"}
    },
    "status": {"const": "design_input_non_authoritative"},
    "title": {"$ref": "#/$defs/nonempty"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "possiblyEmptyStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"}
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibility", "blueprint_id", "entry", "exit", "implementation_status", "objects", "presentation", "proof_ceiling", "purpose", "requirement_ids", "scope", "state_model_id", "swiftui_anatomy", "title"],
      "properties": {
        "accessibility": {"$ref": "#/$defs/stringArray"},
        "blueprint_id": {"type": "string", "pattern": "^UX-SCREEN-[A-Z0-9-]+$"},
        "entry": {"$ref": "#/$defs/nonempty"},
        "exit": {"$ref": "#/$defs/nonempty"},
        "implementation_status": {"const": "design_input_only"},
        "objects": {"$ref": "#/$defs/stringArray"},
        "presentation": {"$ref": "#/$defs/nonempty"},
        "proof_ceiling": {"const": "Design input only; no implementation, runtime, rendered-app, accessibility, device, privacy/legal, distribution, or release proof."},
        "purpose": {"$ref": "#/$defs/nonempty"},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "scope": {"enum": ["account", "app-shell", "capture", "goals", "offline-degraded", "permissions", "search", "setup", "time", "today", "trust", "you"]},
        "state_model_id": {"type": "string", "pattern": "^UX-STATE-[A-Z0-9-]+$"},
        "swiftui_anatomy": {"$ref": "#/$defs/nonempty"},
        "title": {"$ref": "#/$defs/nonempty"}
      }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "implementation_status", "proof_ceiling", "requirement_ids", "screen_id", "taxonomy", "title", "variants"],
      "properties": {
        "blueprint_id": {"type": "string", "pattern": "^UX-STATE-MODEL-[A-Z0-9-]+$"},
        "implementation_status": {"const": "design_input_only"},
        "proof_ceiling": {"const": "Design input only; no implementation, runtime, rendered-app, accessibility, device, privacy/legal, distribution, or release proof."},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "screen_id": {"type": "string", "pattern": "^UX-SCREEN-[A-Z0-9-]+$"},
        "taxonomy": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stateTaxonomy"}
        },
        "variants": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stateVariant"}
        },
        "title": {"$ref": "#/$defs/nonempty"}
      }
    },
    "objectBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "create", "delete_restore", "detail", "edit", "history_inspection", "implementation_status", "object_id", "presentation_boundaries", "proof_ceiling", "requirement_ids", "title"],
      "properties": {
        "blueprint_id": {"type": "string", "pattern": "^UX-OBJECT-[A-Z0-9-]+$"},
        "create": {"$ref": "#/$defs/nonempty"},
        "delete_restore": {"$ref": "#/$defs/nonempty"},
        "detail": {"$ref": "#/$defs/nonempty"},
        "edit": {"$ref": "#/$defs/nonempty"},
        "history_inspection": {"$ref": "#/$defs/nonempty"},
        "implementation_status": {"const": "design_input_only"},
        "object_id": {"$ref": "#/$defs/nonempty"},
        "presentation_boundaries": {"$ref": "#/$defs/nonempty"},
        "proof_ceiling": {"const": "Design input only; no implementation, runtime, rendered-app, accessibility, device, privacy/legal, distribution, or release proof."},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "title": {"$ref": "#/$defs/nonempty"}
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibility", "blueprint_id", "branches", "cancellation", "commit_boundary", "failure", "happy_path", "implementation_status", "interruption_resume", "offline", "preconditions", "proof_ceiling", "recovery", "requirement_ids", "rollback", "tests", "title", "trigger"],
      "properties": {
        "accessibility": {"$ref": "#/$defs/nonempty"},
        "blueprint_id": {"type": "string", "pattern": "^UX-JOURNEY-[A-Z0-9-]+$"},
        "branches": {"$ref": "#/$defs/stringArray"},
        "cancellation": {"$ref": "#/$defs/nonempty"},
        "commit_boundary": {"$ref": "#/$defs/nonempty"},
        "failure": {"$ref": "#/$defs/nonempty"},
        "happy_path": {"$ref": "#/$defs/stringArray"},
        "implementation_status": {"const": "design_input_only"},
        "interruption_resume": {"$ref": "#/$defs/nonempty"},
        "offline": {"$ref": "#/$defs/nonempty"},
        "preconditions": {"$ref": "#/$defs/stringArray"},
        "proof_ceiling": {"const": "Design input only; no implementation, runtime, rendered-app, accessibility, device, privacy/legal, distribution, or release proof."},
        "recovery": {"$ref": "#/$defs/nonempty"},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "rollback": {"$ref": "#/$defs/nonempty"},
        "tests": {"$ref": "#/$defs/stringArray"},
        "title": {"$ref": "#/$defs/nonempty"},
        "trigger": {"$ref": "#/$defs/nonempty"}
      }
    },
    "crossCutting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "contract", "facet", "implementation_status", "proof_ceiling", "requirement_ids", "title", "variants"],
      "properties": {
        "blueprint_id": {"type": "string", "pattern": "^UX-CROSS-[A-Z0-9-]+$"},
        "contract": {"$ref": "#/$defs/nonempty"},
        "facet": {"enum": ["dynamic-type", "focus-keyboard", "light-dark", "localization-long-copy", "motion-haptics", "non-color-semantics", "reduce-motion", "reduce-transparency", "sensitive-exposure-channels", "swiftui-anatomy", "voiceover-reading-order"]},
        "implementation_status": {"const": "design_input_only"},
        "proof_ceiling": {"const": "Design input only; no implementation, runtime, rendered-app, accessibility, device, privacy/legal, distribution, or release proof."},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "title": {"$ref": "#/$defs/nonempty"},
        "variants": {"$ref": "#/$defs/stringArray"}
      }
    },
    "stateTaxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "generic_kind", "rationale", "variant_ids"],
      "properties": {
        "applicability": {"enum": ["applicable", "not_applicable"]},
        "generic_kind": {"enum": ["degraded", "empty", "failure", "interruption", "loading", "recovery", "resting", "rollback", "transitional"]},
        "rationale": {"$ref": "#/$defs/nonempty"},
        "variant_ids": {"$ref": "#/$defs/possiblyEmptyStringArray"}
      }
    },
    "sensitiveExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "channel", "consent", "defaults", "denial_behavior", "implementation_status", "proof_behavior", "proof_ceiling", "protection", "redaction", "requirement_ids", "retention", "user_control", "visible_fields"],
      "properties": {
        "blueprint_id": {"type": "string", "pattern": "^UX-SECURITY-CHANNEL-[A-Z0-9-]+$"},
        "channel": {"enum": ["app-switcher", "capture", "clipboard", "diagnostics", "export", "notifications", "spotlight", "support", "widgets"]},
        "consent": {"$ref": "#/$defs/nonempty"},
        "defaults": {"$ref": "#/$defs/nonempty"},
        "denial_behavior": {"$ref": "#/$defs/nonempty"},
        "implementation_status": {"const": "design_input_only"},
        "proof_behavior": {"$ref": "#/$defs/nonempty"},
        "proof_ceiling": {"const": "Design input only; no implementation, runtime, rendered-app, accessibility, device, privacy/legal, distribution, or release proof."},
        "protection": {"$ref": "#/$defs/nonempty"},
        "redaction": {"$ref": "#/$defs/nonempty"},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "retention": {"$ref": "#/$defs/nonempty"},
        "user_control": {"$ref": "#/$defs/nonempty"},
        "visible_fields": {"$ref": "#/$defs/nonempty"}
      }
    },
    "stateVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibility_focus", "allowed_commands", "behavior_authority_evidence", "behavior_authority_posture", "behavior_authority_rationale", "behavior_requirement_ids", "blueprint_id", "displayed_objects", "durable_effect", "future_gated_commands", "generic_kind", "implementation_status", "machine_command_contracts", "offline_behavior", "operation_phase", "proof_ceiling", "recovery_rollback", "requirement_ids", "specification_gap_ids", "state_axis", "title", "transition_exit", "variant_key", "visible_content_copy", "visible_presentation"],
      "properties": {
        "accessibility_focus": {"$ref": "#/$defs/nonempty"},
        "allowed_commands": {"$ref": "#/$defs/possiblyEmptyStringArray"},
        "behavior_authority_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/behaviorAuthorityEvidence"}
        },
        "behavior_authority_posture": {"enum": ["exploratory_blocked_by_specification_gap", "requirement_backed"]},
        "behavior_authority_rationale": {"$ref": "#/$defs/nonempty"},
        "behavior_requirement_ids": {"$ref": "#/$defs/possiblyEmptyStringArray"},
        "blueprint_id": {"type": "string", "pattern": "^UX-STATE-VARIANT-[A-Z0-9-]+$"},
        "displayed_objects": {"$ref": "#/$defs/possiblyEmptyStringArray"},
        "durable_effect": {"$ref": "#/$defs/nonempty"},
        "future_gated_commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["activation_posture", "command_id", "gate_requirement_ids", "label"],
            "properties": {
              "activation_posture": {"const": "future_gated"},
              "command_id": {"type": "string", "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
              "gate_requirement_ids": {"$ref": "#/$defs/requirementIds"},
              "label": {"$ref": "#/$defs/nonempty"}
            }
          }
        },
        "machine_command_contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/machineCommandContract"}
        },
        "generic_kind": {"enum": ["degraded", "empty", "failure", "interruption", "loading", "recovery", "resting", "rollback", "transitional"]},
        "implementation_status": {"const": "design_input_only"},
        "offline_behavior": {"$ref": "#/$defs/nonempty"},
        "operation_phase": {"enum": ["failed", "idle", "in_progress", "not_applicable", "rolling_back", "succeeded"]},
        "proof_ceiling": {"const": "Design input only; no implementation, runtime, rendered-app, accessibility, device, privacy/legal, distribution, or release proof."},
        "recovery_rollback": {"$ref": "#/$defs/nonempty"},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"},
        "specification_gap_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GAP-UX-[A-Z0-9-]+-[0-9]{3}$"}},
        "state_axis": {"enum": ["availability", "checkpoint", "interruption", "lifecycle", "operation", "presentation", "recovery"]},
        "title": {"$ref": "#/$defs/nonempty"},
        "transition_exit": {"$ref": "#/$defs/nonempty"},
        "variant_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "visible_content_copy": {"type": "string"},
        "visible_presentation": {"$ref": "#/$defs/nonempty"}
      }
    },
    "specificationGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected_screen_families", "affected_state_ids", "authority_consequence", "blocked_fields", "gap_id", "source_rationale"],
      "properties": {
        "affected_screen_families": {"$ref": "#/$defs/stringArray"},
        "affected_state_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^UX-STATE-VARIANT-[A-Z0-9-]+$"}
        },
        "authority_consequence": {"$ref": "#/$defs/nonempty"},
        "blocked_fields": {"$ref": "#/$defs/stringArray"},
        "gap_id": {"type": "string", "pattern": "^GAP-UX-[A-Z0-9-]+-[0-9]{3}$"},
        "source_rationale": {"$ref": "#/$defs/nonempty"}
      }
    },
    "behaviorAuthorityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normative_clause", "owned_fields", "requirement_id"],
      "properties": {
        "normative_clause": {"$ref": "#/$defs/nonempty"},
        "owned_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["accessibility_focus", "allowed_commands", "durable_effect", "future_gated_commands", "offline_behavior", "recovery_rollback", "transition_exit"]}
        },
        "requirement_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+-[0-9]{3}$"}
      }
    },
    "machineTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detail", "id", "posture", "resolution_record"],
      "properties": {
        "detail": {"$ref": "#/$defs/nonempty"},
        "id": {"type": "string", "pattern": "^(?:DEST|FOCUS)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "posture": {"enum": ["current", "deferred", "unavailable"]},
        "resolution_record": {"$ref": "#/$defs/resolutionRecord"}
      }
    },
    "machineRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "detail", "id", "inverse_command_id", "irreversible_confirmation_id", "irreversible_receipt_id", "mechanism_commands", "mechanism_records", "owner", "posture", "recovery_handoff_command_id", "resolution_record", "rollback_posture"],
      "properties": {
        "checkpoint_id": {"type": ["string", "null"], "pattern": "^CHECKPOINT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "detail": {"$ref": "#/$defs/nonempty"},
        "id": {"type": "string", "pattern": "^RECOVERY-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "inverse_command_id": {"type": ["string", "null"], "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "irreversible_confirmation_id": {"type": ["string", "null"], "pattern": "^CONFIRMATION-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "irreversible_receipt_id": {"type": ["string", "null"], "pattern": "^RECEIPT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "mechanism_commands": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/recoveryMechanismCommand"}},
        "mechanism_records": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resolutionRecord"}},
        "owner": {"$ref": "#/$defs/nonempty"},
        "posture": {"enum": ["current", "deferred", "unavailable"]},
        "recovery_handoff_command_id": {"type": ["string", "null"], "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "resolution_record": {"$ref": "#/$defs/resolutionRecord"},
        "rollback_posture": {"type": ["string", "null"], "enum": ["checkpoint_restore", "confirmed_irreversible", "inverse_command", "owner_recovery_handoff", null]}
      }
    },
    "recoveryMechanismCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "mechanism_kind", "redo", "state_command_record_sha256", "trigger_command_id"],
      "properties": {
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activation_posture", "canonical_owner", "command_id", "commit_boundary", "effect", "failure_focus", "gate_dependency_ids", "gate_requirement_ids", "label", "preconditions", "presentation", "privacy_egress", "recovery_id", "recovery_owner", "recovery_posture", "rollback_undo", "verification_ids"],
          "properties": {
            "activation_posture": {"enum": ["active", "future_gated"]},
            "canonical_owner": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
            "command_id": {"type": "string", "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
            "commit_boundary": {"$ref": "#/$defs/nonempty"},
            "effect": {"$ref": "#/$defs/nonempty"},
            "failure_focus": {"$ref": "#/$defs/nonempty"},
            "gate_dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}},
            "gate_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
            "label": {"$ref": "#/$defs/nonempty"},
            "preconditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
            "presentation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["destination", "destination_id", "destination_posture", "failure_focus_id", "failure_focus_posture", "success_focus", "success_focus_id", "success_focus_posture"],
              "properties": {
                "destination": {"$ref": "#/$defs/nonempty"},
                "destination_id": {"type": "string", "pattern": "^DEST-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
                "destination_posture": {"enum": ["current", "deferred", "unavailable"]},
                "failure_focus_id": {"type": "string", "pattern": "^FOCUS-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
                "failure_focus_posture": {"enum": ["current", "deferred", "unavailable"]},
                "success_focus": {"$ref": "#/$defs/nonempty"},
                "success_focus_id": {"type": "string", "pattern": "^FOCUS-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
                "success_focus_posture": {"enum": ["current", "deferred", "unavailable"]}
              }
            },
            "privacy_egress": {"$ref": "#/$defs/nonempty"},
            "recovery_id": {"type": "string", "pattern": "^RECOVERY-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
            "recovery_owner": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
            "recovery_posture": {"enum": ["current", "deferred", "unavailable"]},
            "rollback_undo": {"$ref": "#/$defs/nonempty"},
            "verification_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
          }
        },
        "mechanism_kind": {"enum": ["inverse_command", "recovery_handoff_command"]},
        "redo": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["authorization_posture", "command_id", "receipt_posture", "revision_posture"],
              "properties": {
                "authorization_posture": {"const": "fresh_task_authorization_required"},
                "command_id": {"type": "string", "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
                "receipt_posture": {"const": "current_inverse_receipt_required"},
                "revision_posture": {"const": "current_revision_required"}
              }
            }
          ]
        },
        "state_command_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trigger_command_id": {"type": "string", "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
      }
    },
    "machineCommandContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_posture", "command_id", "destination", "failure_focus", "label", "recovery", "resolution_registry", "success_focus"],
      "properties": {
        "activation_posture": {"enum": ["active", "future_gated"]},
        "command_id": {"type": "string", "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "destination": {"$ref": "#/$defs/machineTarget"},
        "failure_focus": {"$ref": "#/$defs/machineTarget"},
        "label": {"$ref": "#/$defs/nonempty"},
        "recovery": {"$ref": "#/$defs/machineRecovery"},
        "resolution_registry": {"$ref": "#/$defs/resolutionRegistry"},
        "success_focus": {"$ref": "#/$defs/machineTarget"}
      }
    },
    "resolutionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "registry_revision", "source_sha256"],
      "properties": {
        "registry_id": {"const": "COMMAND-RESOLUTION-REGISTRY-001"},
        "registry_revision": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "resolutionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_sha256", "resolution_id"],
      "properties": {
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "resolution_id": {"type": "string", "pattern": "^(?:DEST|FOCUS|RECOVERY|CMD|CHECKPOINT|CONFIRMATION|RECEIPT)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "state_command_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "setupContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle_states", "resume_checkpoint_mapping", "subordinate_content"],
      "properties": {
        "lifecycle_states": {"type": "array", "const": ["in-progress", "not-started", "revisitable", "skipped", "sufficient-for-local-use"]},
        "resume_checkpoint_mapping": {
          "type": "object",
          "additionalProperties": {"enum": ["in-progress", "not-started", "revisitable", "skipped", "sufficient-for-local-use"]}
        },
        "subordinate_content": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/setupContent"}
        }
      }
    },
    "setupContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "purpose", "requirement_ids"],
      "properties": {
        "content_id": {"enum": ["optional-account", "permissions-choice", "welcome"]},
        "purpose": {"$ref": "#/$defs/nonempty"},
        "requirement_ids": {"$ref": "#/$defs/requirementIds"}
      }
    },
    "requirementDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_ids", "disposition", "rationale", "requirement_id", "requirement_text_sha256", "source_path", "state_blueprint_ids"],
      "properties": {
        "blueprint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^UX-[A-Z0-9-]+$"}},
        "disposition": {"enum": ["nonvisual_with_rationale", "visual_mapping_required"]},
        "rationale": {"$ref": "#/$defs/nonempty"},
        "requirement_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"},
        "requirement_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_path": {"$ref": "#/$defs/nonempty"},
        "state_blueprint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^UX-STATE-(?:VARIANT-)?[A-Z0-9-]+$"}}
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
