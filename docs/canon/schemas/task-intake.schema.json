{
  "$id": "https://ambitions.local/canon/schemas/task-intake.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Untrusted request-only ChatGPT-to-Codex task intake. This document never authorizes implementation or merge.",
  "properties": {
    "intake_id": {"minLength": 1, "type": "string"},
    "issue_reference": {"minLength": 1, "type": "string"},
    "requested_authorization_mode": {"const": "path-roots", "type": "string"},
    "requested_changed_files": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "requested_claim_ceiling": {"minLength": 1, "type": "string"},
    "requested_proof": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "requested_requirement_ids": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "requested_path_roots": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "requested_max_changed_files": {"minimum": 1, "type": "integer"},
    "requested_max_changed_bytes": {"minimum": 1, "type": "integer"},
    "requested_rollback": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "requested_scope": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "requested_skill_adapters": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "requested_task_type": {"minLength": 1, "type": "string"},
    "requested_validation": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "schema_version": {"const": 1, "type": "integer"},
    "task_id": {"minLength": 1, "type": "string"}
  },
  "allOf": [
    {
      "if": {"required": ["requested_authorization_mode"]},
      "then": {
        "properties": {"requested_changed_files": {"maxItems": 0}},
        "required": ["requested_path_roots", "requested_max_changed_files", "requested_max_changed_bytes"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["requested_path_roots"]},
            {"required": ["requested_max_changed_files"]},
            {"required": ["requested_max_changed_bytes"]}
          ]
        },
        "properties": {"requested_changed_files": {"minItems": 1}}
      }
    }
  ],
  "required": [
    "schema_version",
    "intake_id",
    "task_id",
    "issue_reference",
    "requested_task_type",
    "requested_scope",
    "requested_requirement_ids",
    "requested_changed_files",
    "requested_validation",
    "requested_proof",
    "requested_rollback",
    "requested_claim_ceiling",
    "requested_skill_adapters"
  ],
  "title": "Ambitions Task Intake",
  "type": "object"
}
