  "title": "Ambitions Visual Authority R1 Node Snapshot",
  "type": "object",
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "visual_authority_id": {
          "pattern": "^VA-P[34]-[A-Z0-9-]+$",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "visual_authority_id"
      ],
      "type": "object"
    },
    "emptyArray": {
      "maxItems": 0,
      "type": "array"
    },
    "nodeId": {
      "pattern": "^[0-9]+:[0-9]+$",
      "type": "string"
    },
    "renderProof": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "taskAuthorityId": {
      "pattern": "^VA-P4-(?:A11Y-CLASS|CANDIDATE)-[0-9]{3}$",
      "type": "string"
    },
    "normalizedNode": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "fill_paints": {
          "items": {
            "$ref": "#/$defs/paint"
          },
          "type": "array"
        },
        "geometry": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "opacity": {
          "type": "number"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "shape_kind": {
          "enum": [
            "circle",
            "component"
          ]
        },
        "stroke_paints": {
          "items": {
            "$ref": "#/$defs/paint"
          },
          "type": "array"
        },
        "stroke_weight": {
          "type": "number"
        },
        "vectors": {
          "items": {
            "$ref": "#/$defs/vector"
          },
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "fill_paints",
        "geometry",
        "opacity",
        "role",
        "shape_kind",
        "stroke_paints",
        "stroke_weight",
        "vectors"
      ],
      "type": "object"
    },
    "paint": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "pattern": "^#[0-9A-F]{6}$",
          "type": "string"
        },
        "opacity": {
          "type": "number"
        },
        "type": {
          "const": "SOLID"
        }
      },
      "required": [
        "color",
        "opacity",
        "type"
      ],
      "type": "object"
    },
    "rawNodePair": {
      "additionalProperties": false,
      "properties": {
        "old_node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "old_node_type": {
          "minLength": 1,
          "type": "string"
        },
        "old_visible": {
          "type": "boolean"
        },
        "replacement_node_id": {
          "$ref": "#/$defs/nodeId"
        },
        "replacement_node_type": {
          "minLength": 1,
          "type": "string"
        },
        "replacement_visible": {
          "type": "boolean"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "old_node_id",
        "old_node_type",
        "old_visible",
        "replacement_node_id",
        "replacement_node_type",
        "replacement_visible",
        "role"
      ],
      "type": "object"
    },
    "reviewRepairReceipt": {
      "additionalProperties": false,
      "properties": {
        "atomic_write_count": {
          "const": 2
        },
        "created_node_ids": {
          "items": {
            "$ref": "#/$defs/nodeId"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "failed_atomic_attempt_count": {
          "const": 1
        },
        "failed_atomic_debug_uuid": {
          "minLength": 1,
          "type": "string"
        },
        "hidden_retained_node_ids": {
          "items": {
            "$ref": "#/$defs/nodeId"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "mutated_node_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 13,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "atomic_write_count",
        "created_node_ids",
        "failed_atomic_attempt_count",
        "failed_atomic_debug_uuid",
        "hidden_retained_node_ids",
        "mutated_node_ids"
      ],
      "type": "object"
    },
    "screenMapping": {
      "additionalProperties": false,
      "properties": {
        "authority_eligible_state_count": {
          "minimum": 0,
          "type": "integer"
        },
        "blueprint_id": {
          "pattern": "^UX-SCREEN-",
          "type": "string"
        },
        "future_gated_state_count": {
          "minimum": 0,
          "type": "integer"
        },
        "gap_blocked_state_count": {
          "minimum": 0,
          "type": "integer"
        },
        "state_variant_ids": {
          "items": {
            "pattern": "^UX-STATE-VARIANT-",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "authority_eligible_state_count",
        "blueprint_id",
        "future_gated_state_count",
        "gap_blocked_state_count",
        "state_variant_ids"
      ],
      "type": "object"
    },
    "vector": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "stroke_paints": {
          "items": {
            "$ref": "#/$defs/paint"
          },
          "type": "array"
        },
        "stroke_weight": {
          "type": "number"
        }
      },
      "required": [
        "geometry",
        "paths",
        "stroke_paints",
        "stroke_weight"
      ],
      "type": "object"
    }
