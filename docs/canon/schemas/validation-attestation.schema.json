{
  "$id": "https://ambitions.local/canon/schemas/validation-attestation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Cryptographically verified CI-owned validation result bound to one exact authorization tuple.",
  "properties": {
    "app_id": {"minLength": 1, "type": "string"},
    "artifact_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "attestation_id": {"minLength": 1, "type": "string"},
    "attestation_origin": {"const": "trusted-ci", "type": "string"},
    "authorization_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "check_identity": {"minLength": 1, "type": "string"},
    "ci_owned": {"const": true, "type": "boolean"},
    "claim_ceiling": {"minLength": 1, "type": "string"},
    "command_argv_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "command_id": {"minLength": 1, "type": "string"},
    "command_manifest_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "exit_status": {"minimum": 0, "type": "integer"},
    "intake_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "intake_id": {"minLength": 1, "type": "string"},
    "integration_id": {"minLength": 1, "type": "string"},
    "merge_base_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
    "policy_revision": {"minLength": 1, "type": "string"},
    "proof_obligation_ids": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "pull_request_number": {"minimum": 1, "type": "integer"},
    "repository_full_name": {"minLength": 1, "type": "string"},
    "repository_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1, "type": "integer"},
    "signature_algorithm": {"const": "rsa-pkcs1v15-sha256", "type": "string"},
    "signature_base64url": {"pattern": "^[A-Za-z0-9_-]+$", "type": "string"},
    "skipped": {"type": "boolean"},
    "skipped_reason": {"type": ["string", "null"]},
    "status": {"enum": ["green", "red"], "type": "string"},
    "task_id": {"minLength": 1, "type": "string"},
    "trust_anchor_id": {"minLength": 1, "type": "string"},
    "trust_anchor_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "trusted_base_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
    "trusted_head_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
    "workflow_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "workflow_path": {"minLength": 1, "type": "string"},
    "workflow_ref": {"minLength": 1, "type": "string"}
  },
  "required": [
    "schema_version", "attestation_id", "attestation_origin",
    "pull_request_number", "task_id", "intake_id", "intake_digest",
    "policy_revision", "authorization_digest", "command_manifest_digest",
    "workflow_path", "workflow_ref", "workflow_digest", "command_id",
    "command_argv_digest", "check_identity", "repository_id",
    "repository_full_name", "trusted_base_sha", "trusted_head_sha",
    "merge_base_sha", "integration_id", "app_id", "exit_status",
    "artifact_digest", "proof_obligation_ids", "skipped", "skipped_reason", "status", "claim_ceiling",
    "ci_owned", "trust_anchor_id", "trust_anchor_sha256",
    "signature_algorithm", "signature_base64url"
  ],
  "title": "Ambitions Validation Attestation",
  "type": "object"
}
