{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/canon/schemas/command-gate-approval-receipt.schema.json",
  "title": "Ambitions Command-Gate Approval Receipt Registry",
  "description": "Independent exact owner-approval receipts for future command-gate mappings; an empty registry grants no authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_revision",
    "canon_revision",
    "canon_content_sha256",
    "approval_receipts"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "registry_id": {"type": "string", "const": "COMMAND-GATE-APPROVAL-RECEIPT-REGISTRY-001"},
    "registry_revision": {"type": "integer", "minimum": 1},
    "canon_revision": {"type": "integer", "minimum": 0},
    "canon_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/approvalReceipt"}
    }
  },
  "$defs": {
    "approvalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_concept", "requirement_id", "state_id", "command_id"],
      "properties": {
        "owner_concept": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "requirement_id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "state_id": {"type": "string", "pattern": "^UX-STATE-VARIANT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "command_id": {"type": "string", "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
      }
    },
    "approvalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_revision",
        "dependency_id",
        "dependency_revision",
        "mapping_record_id",
        "exact_product_mappings",
        "mapping_sha256",
        "dependency_sha256",
        "canon_content_sha256",
        "approval_identity",
        "approval_state",
        "approved_scope",
        "approved_scope_sha256",
        "previous_receipt_sha256",
        "receipt_sha256"
      ],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^APPROVAL-RECEIPT-GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*-R[0-9]{4,}$"},
        "receipt_revision": {"type": "integer", "minimum": 2},
        "dependency_id": {"type": "string", "pattern": "^GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "dependency_revision": {"type": "integer", "minimum": 2},
        "mapping_record_id": {"type": "string", "pattern": "^MAPPING-GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*-R[0-9]{4,}$"},
        "exact_product_mappings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dependency_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canon_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval_identity": {"type": "string", "pattern": "^OWNER-APPROVAL-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "approval_state": {"const": "approved"},
        "approved_scope": {"$ref": "#/$defs/approvalScope"},
        "approved_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "previous_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
