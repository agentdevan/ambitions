{
  "$id": "https://ambitions.local/canon/schemas/task-authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministically computed task-start envelope. It is advisory locally and must be independently regenerated by trusted CI.",
  "properties": {
    "approval_attestation_digests": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array", "uniqueItems": true},
    "approval_nonce_consumptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attestation_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "attestation_id": {"minLength": 1, "type": "string"},
          "consumption_snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "consumption_generation": {"minimum": 1, "type": "integer"},
          "event_projection_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "nonce": {"minLength": 1, "type": "string"},
          "workflow_run_attempt": {"minimum": 1, "type": "integer"},
          "workflow_run_id": {"minimum": 1, "type": "integer"}
        },
        "required": ["nonce", "attestation_id", "attestation_digest", "consumption_snapshot_sha256", "consumption_generation", "workflow_run_id", "workflow_run_attempt", "event_projection_digest"],
        "type": "object"
      },
      "type": "array"
    },
    "authority_class": {"enum": ["advisory-local", "ci-candidate"], "type": "string"},
    "computed_authorized_files": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "computed_command_digests": {"additionalProperties": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "object"},
    "computed_proof_command_bindings": {"additionalProperties": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}, "type": "object"},
    "computed_claim_ceiling": {"minLength": 1, "type": "string"},
    "computed_proof_obligations": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "computed_required_checks": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "exact_diff_authorized": {"const": false, "type": "boolean"},
    "intake": {"$ref": "task-intake.schema.json"},
    "intake_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "merge_authorized": {"const": false, "type": "boolean"},
    "local_state": {
      "oneOf": [
        {"type": "null"},
        {
          "additionalProperties": false,
          "properties": {
            "head_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
            "head_to_index_delta": {"$ref": "#/properties/tree_delta"},
            "head_to_worktree_delta": {"$ref": "#/properties/tree_delta"},
            "head_tree_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
            "index_tree_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
            "schema_version": {"const": 1, "type": "integer"},
            "worktree_tree_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"}
          },
          "required": ["schema_version", "head_sha", "head_tree_sha", "index_tree_sha", "worktree_tree_sha", "head_to_index_delta", "head_to_worktree_delta"],
          "type": "object"
        }
      ]
    },
    "mode": {"enum": ["local-advisory", "ci-pr-range"], "type": "string"},
    "resolved_skill_adapters": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
    "schema_version": {"const": 1, "type": "integer"},
    "skill_conformance_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "tree_delta": {
      "additionalProperties": false,
      "properties": {
        "digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "new_tree_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
        "old_tree_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
        "records": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "new_blob_size": {"minimum": 0, "type": ["integer", "null"]},
              "new_mode": {"type": ["string", "null"]},
              "new_object_id": {"type": ["string", "null"]},
              "new_object_type": {"enum": ["blob", "commit", null]},
              "old_blob_size": {"minimum": 0, "type": ["integer", "null"]},
              "old_mode": {"type": ["string", "null"]},
              "old_object_id": {"type": ["string", "null"]},
              "old_object_type": {"enum": ["blob", "commit", null]},
              "path_display_utf8": {"type": ["string", "null"]},
              "path_raw_base64url": {"pattern": "^[A-Za-z0-9_-]+$", "type": "string"},
              "status": {"enum": ["added", "deleted", "modified"], "type": "string"}
            },
            "required": ["path_raw_base64url", "path_display_utf8", "status", "old_mode", "new_mode", "old_object_type", "new_object_type", "old_object_id", "new_object_id", "old_blob_size", "new_blob_size"],
            "type": "object"
          },
          "type": "array"
        },
        "schema_version": {"const": 1, "type": "integer"}
      },
      "required": ["schema_version", "old_tree_sha", "new_tree_sha", "records", "digest"],
      "type": "object"
    },
    "trusted_bindings": {
      "additionalProperties": false,
      "properties": {
        "canon_revision": {"minimum": 0, "type": "integer"},
        "canon_source_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "approval_nonce_consumption_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "command_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "conflict_state_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "issue_state_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "known_issues_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "policy_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "policy_revision": {"minLength": 1, "type": "string"},
        "proof_state_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "schema_revision": {"minLength": 1, "type": "string"},
        "skill_dependencies_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "skill_conformance_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "source_ownership_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "trust_anchors_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "validation_workflow_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["canon_revision", "canon_source_sha256", "policy_sha256", "policy_revision", "schema_revision", "source_ownership_sha256", "issue_state_sha256", "known_issues_sha256", "proof_state_sha256", "conflict_state_sha256", "skill_dependencies_sha256", "skill_conformance_sha256", "approval_nonce_consumption_sha256", "command_manifest_sha256", "trust_anchors_sha256", "validation_workflow_sha256"],
      "type": "object"
    },
    "trusted_event_provenance": {"$ref": "trusted-event.schema.json"}
  },
  "$defs": {
    "taskFinalizationReceipt": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "local-advisory"}}, "required": ["mode"]},
          "then": {"properties": {"authority_class": {"const": "advisory-local-finalization"}, "merge_authorized": {"const": false}}}
        },
        {
          "if": {"properties": {"mode": {"const": "ci-pr-range"}}, "required": ["mode"]},
          "then": {"properties": {"authority_class": {"const": "ci-pr-range-finalization"}, "merge_authorized": {"const": true}}}
        }
      ],
      "properties": {
        "approval_nonce_consumptions": {"$ref": "#/properties/approval_nonce_consumptions"},
        "authority_class": {"enum": ["advisory-local-finalization", "ci-pr-range-finalization"], "type": "string"},
        "authorization_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "claim_ceiling": {"minLength": 1, "type": "string"},
        "computed_authorized_files": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
        "delegation_start_authorization_digest": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
        "delegation_start_event_provenance": {"oneOf": [{"type": "null"}, {"$ref": "trusted-event.schema.json"}]},
        "exact_changed_files": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
        "exact_diff_authorized": {"const": true, "type": "boolean"},
        "final_tree_delta": {"$ref": "#/properties/tree_delta"},
        "intake_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "merge_authorized": {"type": "boolean"},
        "mode": {"enum": ["local-advisory", "ci-pr-range"], "type": "string"},
        "proof_obligation_evidence": {"additionalProperties": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array", "uniqueItems": true}, "type": "object"},
        "receipt_type": {"const": "task-finalization", "type": "string"},
        "schema_version": {"const": 1, "type": "integer"},
        "scope_expansion_records": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "changed_bytes": {"minimum": 0, "type": "integer"},
              "changed_file_count": {"minimum": 0, "type": "integer"},
              "changed_files": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
              "head_sha": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
              "previous_record_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "record_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
              "sequence": {"minimum": 1, "type": "integer"},
              "tree_delta_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
            },
            "required": ["sequence", "head_sha", "tree_delta_digest", "changed_files", "changed_file_count", "changed_bytes", "previous_record_sha256", "record_sha256"],
            "type": "object"
          },
          "type": "array"
        },
        "starting_tree_delta": {"$ref": "#/properties/tree_delta"},
        "trusted_bindings": {"$ref": "#/properties/trusted_bindings"},
        "trusted_event_provenance": {"$ref": "trusted-event.schema.json"},
        "validation_attestation_digests": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array", "uniqueItems": true}
      },
      "required": ["schema_version", "receipt_type", "mode", "authority_class", "authorization_digest", "intake_digest", "trusted_event_provenance", "trusted_bindings", "starting_tree_delta", "final_tree_delta", "computed_authorized_files", "exact_changed_files", "validation_attestation_digests", "approval_nonce_consumptions", "proof_obligation_evidence", "scope_expansion_records", "delegation_start_authorization_digest", "delegation_start_event_provenance", "exact_diff_authorized", "merge_authorized", "claim_ceiling"],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "authority_class",
    "intake",
    "intake_digest",
    "trusted_event_provenance",
    "trusted_bindings",
    "tree_delta",
    "local_state",
    "computed_authorized_files",
    "computed_command_digests",
    "computed_proof_command_bindings",
    "computed_required_checks",
    "computed_proof_obligations",
    "computed_claim_ceiling",
    "resolved_skill_adapters",
    "skill_conformance_sha256",
    "approval_attestation_digests",
    "approval_nonce_consumptions",
    "exact_diff_authorized",
    "merge_authorized"
  ],
  "title": "Ambitions Task Authorization",
  "type": "object"
}
