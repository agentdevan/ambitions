{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/canon/schemas/task-pack.schema.json",
  "title": "Ambitions Canon Task Pack",
  "description": "Machine contract for deterministic bounded Codex task-pack content and stale-state rejection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canon_revision",
    "canon_sha",
    "repository_sha",
    "intake_sha",
    "compiler_version",
    "authority_state",
    "issue_id",
    "task_type",
    "budget_class",
    "token_budget",
    "estimated_tokens",
    "scope",
    "changed_files",
    "claim_type",
    "known_issue_ids",
    "intake_path",
    "constitutional_laws",
    "applicable_requirement_ids",
    "specifications",
    "object_lifecycles",
    "journeys",
    "standards",
    "source_owners",
    "implementation_posture",
    "command_authorizations",
    "known_risks",
    "visual_authority",
    "required_tests",
    "required_validation",
    "required_proof",
    "forbidden_changes",
    "open_conflicts",
    "claim_ceiling",
    "rollback_requirements"
  ],
  "properties": {
    "schema_version": {
      "description": "Task-pack contract version.",
      "type": "integer",
      "const": 1
    },
    "canon_revision": {
      "description": "Canon revision from which the pack was compiled.",
      "type": "integer",
      "minimum": 0
    },
    "canon_sha": {
      "description": "Content SHA for the exact normative canon snapshot.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_sha": {
      "description": "Git HEAD plus any tracked or untracked diff state used to detect stale packs.",
      "type": "string",
      "minLength": 1
    },
    "intake_sha": {
      "description": "SHA-256 of the normalized closed issue-intake contract.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiler_version": {
      "description": "Compiler version that generated the pack.",
      "type": "string",
      "minLength": 1
    },
    "authority_state": {
      "description": "Whether the source canon is shadow or active.",
      "type": "string",
      "enum": ["shadow", "active"]
    },
    "issue_id": {
      "description": "Execution issue identity used for the bounded task.",
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "description": "Bounded implementation or inspection task classification.",
      "type": "string",
      "minLength": 1
    },
    "budget_class": {
      "type": "string",
      "enum": ["mechanical", "normal", "complex", "constitutional-audit"]
    },
    "token_budget": {
      "description": "Fail-closed token ceiling, or null for an explicit full-corpus audit.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "estimated_tokens": {
      "description": "Deterministic four-characters-per-token estimate for the Markdown pack.",
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_type": {
      "description": "Evidence claim class requested by the intake.",
      "type": "string",
      "minLength": 1
    },
    "known_issue_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "intake_path": {
      "description": "Repository-relative or explicit path to the hashed task intake.",
      "type": "string",
      "minLength": 1
    },
    "constitutional_laws": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "applicable_requirement_ids": {
      "description": "Complete exact requirement and owning-document identifier set; constitutional laws are listed separately.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "specifications": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "object_lifecycles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "journeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "standards": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_owners": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "implementation_posture": {
      "description": "Evidence-bounded current implementation status text.",
      "type": "string",
      "minLength": 1
    },
    "command_authorizations": {
      "description": "Identity-bound current and future command authorization records. Requirement prose remains unmodified.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activation_authorized",
          "activation_posture",
          "command_id",
          "gate_dependencies",
          "gate_requirement_ids",
          "label",
          "requirement_id",
          "state_id"
        ],
        "properties": {
          "activation_authorized": {"type": "boolean"},
          "activation_posture": {"type": "string", "enum": ["active", "future_gated"]},
          "command_id": {"type": "string", "pattern": "^CMD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
          "gate_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "activation_authorization",
                "dependency_id",
                "dependency_kind",
                "dependency_posture",
                "dependency_revision",
                "dependency_sha256",
                "exact_product_mapping_count",
                "freshness",
                "mapping_sha256",
                "owner_approval_evidence",
                "owner_approval_state",
                "registry_id",
                "registry_revision",
                "source_sha256"
              ],
              "properties": {
                "activation_authorization": {"type": "boolean"},
                "dependency_id": {"type": "string", "pattern": "^GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
                "dependency_kind": {"type": "string", "minLength": 1},
                "dependency_posture": {"type": "string", "enum": ["blocked", "ready"]},
                "dependency_revision": {"type": "integer", "minimum": 1},
                "dependency_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "exact_product_mapping_count": {"type": "integer", "minimum": 0},
                "freshness": {"type": "string", "enum": ["absent", "current", "stale"]},
                "mapping_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "owner_approval_evidence": {"type": ["string", "null"]},
                "owner_approval_state": {"type": "string", "enum": ["approved", "withheld"]},
                "registry_id": {"type": "string", "minLength": 1},
                "registry_revision": {"type": "integer", "minimum": 1},
                "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "gate_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "label": {"type": "string", "minLength": 1},
          "requirement_id": {"type": "string", "minLength": 1},
          "state_id": {"type": "string", "pattern": "^UX-STATE-VARIANT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
        }
      }
    },
    "known_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "visual_authority": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_validation": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_proof": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "open_conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_ceiling": {
      "description": "Highest evidence-supported claim permitted from this pack.",
      "type": "string",
      "minLength": 1
    },
    "rollback_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
