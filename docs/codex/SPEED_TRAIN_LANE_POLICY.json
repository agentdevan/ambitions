{
  "schema_version": 1,
  "date": "2026-05-12",
  "purpose": "Speed Train validation routing for finishing Ambitions batches quickly without false proof claims.",
  "default_stop_policy": {
    "continue_on_green": true,
    "continue_on_accepted_yellow": true,
    "stop_on_red": true,
    "stop_on_unknown": true,
    "stop_on_stale_state": true,
    "stop_on_completed_batch_reactivation": true,
    "stop_on_unsupported_completion_claim": true
  },
  "lanes": {
    "docs_control_plane": {
      "required": [
        "git diff --check",
        "make prompt-audit",
        "python3 scripts/ambitions-stale-state-check.py",
        "python3 scripts/ambitions-unsupported-claim-scan.py docs prompts .codex"
      ],
      "xcode_required": false,
      "full_suite_required": false
    },
    "domain_model": {
      "required": [
        "git diff --check",
        "make batch-self-check",
        "focused domain tests for touched models"
      ],
      "xcode_required": "focused-test only",
      "full_suite_required": false
    },
    "service_seam": {
      "required": [
        "git diff --check",
        "make batch-self-check",
        "focused owner service tests"
      ],
      "xcode_required": "focused-test only",
      "full_suite_required": false
    },
    "persistence_or_schema": {
      "required": [
        "git diff --check",
        "xcodegen generate",
        "focused persistence tests",
        "schema ledger / migration guard tests when touched"
      ],
      "xcode_required": "focused-test plus xcodegen",
      "full_suite_required": false
    },
    "ui_visual": {
      "required": [
        "git diff --check",
        "focused UI or view-model tests",
        "visual proof only when the batch claims visual completion"
      ],
      "xcode_required": "focused-test only unless visual proof claim requires more",
      "full_suite_required": false
    },
    "terminal_release_or_device": {
      "required": [
        "full gate defined by terminal batch prompt"
      ],
      "xcode_required": true,
      "full_suite_required": true
    }
  },
  "heavy_gate": {
    "timing": "after speed run or terminal gate only",
    "commands": [
      "git diff --check",
      "python3 scripts/ambitions-stale-state-check.py",
      "python3 scripts/ambitions-unsupported-claim-scan.py docs prompts .codex",
      "make batch-self-check",
      "make prompt-audit",
      "xcodegen generate",
      "scripts/ambitions-xcode-validate.sh --batch SPEED-TRAIN-FINAL-GATE --lane build-for-testing"
    ]
  }
}
