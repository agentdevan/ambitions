{
  "schema_version": 1,
  "artifact_id": "clarification_engine_model",
  "linear_issue": "AMB-695",
  "parent_issue": "AMB-615",
  "plos_label": "PLOS-073",
  "status": "documentation_control_plane_contract",
  "implemented_in_app": false,
  "runtime_features_implemented": false,
  "required_upstream": [
    "GoalStateAssessment",
    "OperatingMode",
    "GoalIntentGeometry",
    "GoalShapeFingerprint",
    "SourceAuthorityState"
  ],
  "existing_source_owners": [
    "Native/Ambitions/Domain/GoalEngine/GoalClarificationModels.swift",
    "Native/Ambitions/Services/GoalClarificationService.swift",
    "Native/Ambitions/Domain/GoalEngine/GoalUnderstandingModels.swift",
    "Native/Ambitions/Services/GoalUnderstandingService.swift",
    "Native/Ambitions/Domain/GoalEngine/GoalEngineContracts.swift",
    "Native/Ambitions/Services/GoalContradictionService.swift"
  ],
  "clarification_question_required_fields": [
    {
      "id": "question_id",
      "description": "Stable local id for the question contract.",
      "red_stop": "id_contains_raw_private_goal_text"
    },
    {
      "id": "prompt",
      "description": "Short non-shaming user-facing question.",
      "red_stop": "prompt_uses_guilt_urgency_scoring_or_interrogation_tone"
    },
    {
      "id": "target_field",
      "allowed_values": [
        "goal_subject",
        "scope",
        "success_definition",
        "deadline_semantics",
        "ownership",
        "resources",
        "jurisdiction",
        "risk",
        "source_need",
        "definition_of_done"
      ],
      "red_stop": "question_has_no_decision_value"
    },
    {
      "id": "ambiguity_types",
      "description": "Ambiguities addressed by the question.",
      "red_stop": "ambiguity_remains_implicit"
    },
    {
      "id": "value_dimensions",
      "description": "Ranking dimensions improved by the question.",
      "red_stop": "ranking_cannot_explain_why_question_is_asked"
    },
    {
      "id": "blocking",
      "description": "Whether path compilation must wait.",
      "red_stop": "blocking_ambiguity_still_generates_steps"
    },
    {
      "id": "answer_effect",
      "description": "How the answer may change operating mode, geometry, fingerprint inputs, source posture, scope, outcome, or safety route.",
      "red_stop": "answer_cannot_alter_routing"
    },
    {
      "id": "safe_skip_default",
      "description": "Explicit default if the question can be skipped.",
      "red_stop": "skipping_silently_invents_a_plan"
    },
    {
      "id": "privacy_class",
      "allowed_values": [
        "local_only",
        "local_user_context",
        "abstract_gap",
        "blocked"
      ],
      "red_stop": "answer_eligible_for_r2_or_public_source_atlas_material"
    },
    {
      "id": "receipt",
      "description": "Local audit metadata for why a question was asked or skipped.",
      "red_stop": "no_local_trace_for_clarification_decision"
    }
  ],
  "value_ranker_dimensions": [
    "unblocks_operating_mode",
    "tightens_feasibility",
    "establishes_definition_of_done",
    "resolves_deadline_semantics",
    "negotiates_scope_outcome",
    "clarifies_ownership",
    "reduces_risk_jurisdiction",
    "resolves_source_need",
    "preserves_privacy_boundary"
  ],
  "minimal_question_budget": {
    "default_max_questions_before_first_safe_route": 1,
    "max_when_deadline_and_definition_of_done_are_independently_blocking": 2,
    "max_for_high_risk_jurisdiction_delegated_collaborative_or_consequential_decision": 3,
    "ask_informational_questions_before_local_preservation": false,
    "stop_when_next_answer_cannot_change_downstream_route": true
  },
  "output_states": [
    "ask",
    "skip_with_assumption",
    "hold_local_draft",
    "source_needed",
    "coverage_demand_candidate",
    "jurisdiction_needed",
    "unsafe_blocked"
  ],
  "goal_state_assessment_linkage": {
    "goal_states": [
      "new",
      "active",
      "paused",
      "recurring",
      "maintenance",
      "decision",
      "collaborative",
      "blocked",
      "unsafe",
      "unsupported"
    ],
    "deadline_semantics": [
      "hard_deadline",
      "target_date",
      "season",
      "rolling_window",
      "no_date_exploration",
      "recurring_maintenance",
      "unknown"
    ],
    "definition_of_done_states": [
      "explicit",
      "inferred_with_safe_default",
      "missing",
      "unsafe_to_infer"
    ]
  },
  "allowed_downstream_changes": [
    "operating_mode",
    "goal_intent_geometry",
    "goal_shape_fingerprint_inputs",
    "source_posture",
    "source_needed_scaffold",
    "coverage_need_candidate",
    "jurisdiction_needed_route",
    "unsafe_blocked_route",
    "scope",
    "outcome_structure",
    "definition_of_done"
  ],
  "forbidden_external_material": [
    "raw_private_goal_text",
    "private_answer_text",
    "personal_names",
    "proof_detail",
    "exact_schedule",
    "sensitive_freeform_notes",
    "secret_or_credential_data"
  ],
  "fixture_obligations": {
    "minimum_raw_goal_fixtures": 50,
    "same_goal_different_person_families_minimum": 5,
    "must_cover_clarification_needed": true,
    "must_cover_source_needed": true,
    "must_cover_jurisdiction_needed": true,
    "must_cover_high_risk_guarded": true,
    "must_cover_collaborative_and_decision_modes": true,
    "must_prove_ranker_does_not_ask_excessive_questions": true,
    "must_prove_answers_change_routes_only_through_privacy_bounded_canonical_fields": true,
    "executable_corpus_created_by_this_issue": false
  },
  "downstream_consumers": [
    "AMB-696",
    "AMB-697",
    "AMB-698",
    "AMB-699",
    "AMB-700",
    "AMB-701",
    "AMB-617",
    "AMB-619",
    "AMB-620",
    "AMB-623",
    "AMB-635"
  ],
  "red_conditions": [
    "raw_goal_text_goes_directly_to_step_list",
    "broad_intake_questions_asked_before_smallest_valuable_question",
    "question_set_exceeds_minimal_budget_without_safety_or_consequence_justification",
    "clarification_cannot_change_operating_mode_source_posture_geometry_fingerprint_scope_outcome_or_definition_of_done",
    "hard_deadline_and_aspiration_date_treated_the_same",
    "definition_of_done_invented_after_steps_are_generated",
    "source_needed_or_coverage_gap_solved_by_guessing",
    "high_risk_or_jurisdiction_gap_routes_as_ordinary_productivity_question",
    "unsupported_goal_gets_fake_plan",
    "raw_private_goal_or_answer_text_leaves_local_boundary"
  ],
  "non_claims": [
    "app_source_change",
    "swift_implementation",
    "prompt_ui_implementation",
    "runtime_classifier_implementation",
    "validator_automation",
    "executable_fixture_corpus",
    "runtime_path_selection",
    "generated_step_behavior",
    "source_pack_creation",
    "r2_write",
    "coverage_request_transport",
    "runtime_eligibility_computation",
    "ui_implementation",
    "accessibility_proof",
    "privacy_legal_approval",
    "release_readiness",
    "testflight_readiness",
    "app_store_readiness",
    "device_proof",
    "measured_performance_proof",
    "security_certification",
    "AMB-615_parent_completion"
  ]
}
