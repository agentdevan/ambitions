{
  "schema_version": 1,
  "artifact_id": "fresh_coverage_arrival_detection_contract",
  "linear_issue": "AMB-699",
  "parent_issue": "AMB-615",
  "plos_label": "PLOS-077",
  "status": "documentation_control_plane_contract",
  "implemented_in_app": false,
  "runtime_features_implemented": false,
  "network_transport_implemented": false,
  "r2_write_performed": false,
  "required_upstream": [
    "CoverageNeed",
    "CoverageDemandQueue",
    "AbstractCoverageRequest",
    "SourceNeeded",
    "SourceAuthorityNonReadyRoute",
    "AnyGoalSolutionLoopLaw",
    "SourceAtlasAuthorityLaw",
    "SeedBasedPlanningLaw",
    "LocalDataCloudBoundaryLaw"
  ],
  "required_inputs": [
    {
      "id": "coverage_need_ref",
      "description": "Local AMB-697 CoverageNeed id.",
      "red_stop": "arrival_check_without_local_gap_record"
    },
    {
      "id": "coverage_need_dedupe_key",
      "description": "Abstract non-identifying dedupe key.",
      "red_stop": "key_contains_raw_goal_user_id_schedule_or_private_context"
    },
    {
      "id": "goal_family",
      "description": "Coarse reusable family when non-identifying.",
      "red_stop": "family_is_raw_private_goal_phrasing"
    },
    {
      "id": "domain",
      "description": "Coarse domain.",
      "red_stop": "domain_identifies_person_account_location_employer_school_medical_legal_fact_or_private_circumstance"
    },
    {
      "id": "seed_gap_category",
      "description": "AMB-697 abstract seed-gap category.",
      "red_stop": "finished_user_specific_step_or_personal_plan_requested"
    },
    {
      "id": "source_authority_need",
      "allowed_values": [
        "source",
        "review",
        "freshness",
        "compatibility",
        "rollback",
        "release_receipt",
        "jurisdiction"
      ],
      "red_stop": "revoked_or_contradicted_material_treated_as_current"
    },
    {
      "id": "risk_jurisdiction_class",
      "allowed_values": [
        "low",
        "standard",
        "jurisdiction_needed",
        "high_risk_review",
        "unsafe_blocked",
        "unknown_risk"
      ],
      "red_stop": "high_risk_or_jurisdiction_gap_unlocked_as_ordinary_coverage"
    },
    {
      "id": "freshness_review_class",
      "allowed_values": [
        "current_missing",
        "stale",
        "review_needed",
        "source_changed",
        "revoked",
        "contradicted",
        "unreviewed",
        "unknown"
      ],
      "red_stop": "stale_revoked_or_contradicted_state_hidden"
    },
    {
      "id": "privacy_class",
      "description": "AMB-697 CoverageDemand privacy class.",
      "red_stop": "local_private_or_blocked_sensitive_data_sent_to_public_source_atlas_or_r2"
    },
    {
      "id": "request_ref",
      "description": "Optional AMB-698 AbstractCoverageRequest ref when one exists.",
      "red_stop": "arrival_depends_on_remote_request_as_only_local_recovery_path"
    },
    {
      "id": "local_receipt_ref",
      "description": "Receipt explaining the prior source-needed or coverage gap.",
      "red_stop": "user_cannot_inspect_why_routing_changed"
    }
  ],
  "fresh_coverage_candidate_fields": [
    "candidateId",
    "coverageNeedRef",
    "sourcePackOrManifestRef",
    "sourceAuthorityState",
    "sourceFreshnessState",
    "reviewState",
    "riskJurisdictionState",
    "releaseReceiptRef",
    "rollbackReceiptRef",
    "compatibilityState",
    "matchedAbstractFields",
    "blockedReason",
    "routeRecheckState",
    "receiptRef"
  ],
  "allowed_match_fields": [
    "abstractGoalFamily",
    "coarseDomain",
    "reusableSeedGapCategory",
    "sourceAuthorityNeedClass",
    "coarseJurisdictionOrLocaleClass",
    "riskReviewClass",
    "compatibilityClass",
    "releaseReceiptClass",
    "rollbackClass",
    "packKind",
    "schemaVersion"
  ],
  "forbidden_match_fields": [
    "raw_private_goal_text",
    "exact_user_schedule",
    "exact_user_deadline",
    "calendar_reality",
    "private_proof",
    "private_receipts",
    "captures",
    "closure_history",
    "names",
    "relationship_context",
    "private_collaborators",
    "precise_private_location",
    "private_employer",
    "private_school",
    "private_institution",
    "private_account",
    "protected_context",
    "user_id",
    "device_id",
    "icloud_id",
    "email",
    "phone",
    "ip_derived_identity",
    "analytics_identifier",
    "support_identifier",
    "local_learning",
    "behavior_patterns",
    "capability_evidence",
    "private_personalization_slots",
    "secrets_or_credentials",
    "tokens",
    "support_bundles",
    "logs"
  ],
  "lifecycle_states": [
    "not_checked",
    "candidate_detected",
    "source_authority_pending",
    "blocked_by_privacy",
    "blocked_by_source",
    "blocked_by_risk",
    "ready_for_route_recheck",
    "route_rechecked",
    "resolved",
    "expired"
  ],
  "unlock_rules": [
    "matching_artifact_is_public_reusable_non_user_specific_and_source_bound",
    "match_uses_only_allowed_abstract_fields",
    "source_authority_state_is_eligible_or_candidate_eligible_for_scoped_recheck",
    "freshness_review_jurisdiction_risk_compatibility_release_receipt_and_rollback_receipt_checks_are_present_or_explicitly_not_applicable",
    "no_revocation_contradiction_quarantine_high_risk_ordinary_route_gap_private_data_leak_or_unsupported_schema",
    "local_receipt_explains_fresh_coverage_without_claiming_private_context_upload"
  ],
  "fixture_obligations": {
    "fresh_public_starter_seed_matches_source_needed_gap": true,
    "fresh_proof_seed_matches_abstract_proof_gap": true,
    "fresh_elasticity_seed_matches_abstract_elasticity_gap": true,
    "source_freshness_update_unlocks_stale_candidate": true,
    "review_receipt_unlocks_only_after_review_passes": true,
    "missing_release_receipt_blocks_candidate": true,
    "missing_rollback_receipt_blocks_release_sensitive_candidate": true,
    "revoked_source_does_not_unlock": true,
    "contradicted_source_does_not_unlock": true,
    "incompatible_manifest_does_not_unlock": true,
    "high_risk_review_gap_routes_to_guarded_review": true,
    "jurisdiction_needed_gap_remains_guarded_until_resolved": true,
    "same_goal_different_person_rechecks_locally_without_uploading_slots": true,
    "denied_revoked_or_unsent_request_can_still_benefit_from_public_fresh_coverage": true,
    "arrival_candidate_excludes_forbidden_private_fields": true
  },
  "red_conditions": [
    "arrival_detection_requires_uploaded_private_goal_content",
    "fresh_coverage_creates_fake_source_backed_coverage_without_source_authority_proof",
    "route_unlock_uses_forbidden_private_match_fields",
    "high_risk_jurisdiction_revoked_contradicted_quarantined_incompatible_or_missing_receipt_material_unlocks_ordinary_routing",
    "source_needed_becomes_dead_end_when_fresh_public_coverage_exists",
    "route_changes_without_local_receipt",
    "fixture_test_generated_preview_material_treated_as_production_runtime_proof"
  ],
  "downstream_consumers": [
    "AMB-700",
    "AMB-701",
    "AMB-617",
    "AMB-619",
    "AMB-620",
    "AMB-623",
