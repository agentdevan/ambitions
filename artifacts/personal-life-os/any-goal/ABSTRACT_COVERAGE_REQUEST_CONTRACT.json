      "red_stop": "revoked_or_contradicted_material_requested_as_usable_current_coverage"
    },
    {
      "id": "privacy_class",
      "required_value": "remote_abstract_allowed",
      "red_stop": "local_private_local_abstract_or_blocked_sensitive_material_sent"
    },
    {
      "id": "consent_receipt_ref",
      "description": "Local consent receipt.",
      "red_stop": "request_sent_without_consent_proof"
    },
    {
      "id": "redaction_proof_ref",
      "description": "Local proof that forbidden material was excluded.",
      "red_stop": "no_redaction_evidence_exists"
    },
    {
      "id": "transport_state",
      "allowed_values": [
        "not_implemented",
        "blocked",
        "ready_for_future_transport",
        "sent_by_future_owner",
        "revoked"
      ],
      "red_stop": "AMB-698_claims_live_transport"
    },
    {
      "id": "local_retry_ref",
      "description": "Local retry or fresh-coverage hook.",
      "red_stop": "request_has_no_local_recovery_or_revoke_route"
    }
