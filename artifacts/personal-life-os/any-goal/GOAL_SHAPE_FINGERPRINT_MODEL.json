{
  "schema_version": 1,
  "artifact_id": "goal_shape_fingerprint_model",
  "linear_issue": "AMB-694",
  "parent_issue": "AMB-615",
  "plos_label": "PLOS-072",
  "status": "documentation_control_plane_contract",
  "implemented_in_app": false,
  "runtime_features_implemented": false,
  "required_upstream": [
    "GoalIntentGeometry",
    "GoalStateAssessment",
    "OperatingMode",
    "SourceAuthorityState"
  ],
  "required_fields": [
    {
      "id": "fingerprint_id",
      "description": "Stable local id for the canonical fingerprint record.",
      "red_stop": "id_contains_raw_goal_text_or_private_context"
    },
    {
      "id": "schema_version",
      "description": "Version of the fingerprint contract.",
      "red_stop": "version_omitted_making_replay_ambiguous"
    },
    {
      "id": "geometry_ref",
      "description": "Reference to the local GoalIntentGeometry record.",
      "red_stop": "fingerprint_bypasses_geometry"
    },
    {
      "id": "geometry_digest",
      "description": "Digest of allowed geometry fields only.",
      "red_stop": "digest_includes_raw_private_text_or_hidden_assumptions"
    },
    {
      "id": "operating_mode",
      "description": "AMB-692 mode id that scoped the route.",
      "red_stop": "fingerprint_ignores_operating_mode"
    },
    {
      "id": "goal_state",
      "description": "Goal state from GoalStateAssessment.",
      "red_stop": "goal_state_inferred_after_step_generation"
    },
    {
      "id": "domain",
      "description": "Broad domain family.",
      "red_stop": "unknown_domain_becomes_generic_plan_fingerprint"
    },
    {
      "id": "specific_domain",
      "description": "Optional narrower domain when explicit or source-supported.",
      "red_stop": "narrow_domain_stereotype_derived"
    },
    {
      "id": "deadline_semantics",
      "allowed_values": [
        "hard_deadline",
        "target_date",
        "season",
        "rolling_window",
        "no_date_exploration",
        "recurring_maintenance",
        "unknown"
      ],
      "red_stop": "hard_deadline_and_aspiration_date_hash_the_same"
    },
    {
      "id": "ambiguity_state",
      "description": "Clear or missing/unsafe-to-infer state.",
      "red_stop": "ambiguous_and_clear_goals_hash_the_same"
    },
    {
      "id": "risk_class",
      "description": "Safety, jurisdiction, and reversibility posture.",
      "red_stop": "high_risk_and_low_risk_goals_hash_the_same"
    },
    {
      "id": "jurisdiction_posture",
      "allowed_values": [
        "not_needed",
        "needed",
        "known",
        "unknown",
        "blocked",
        "review_needed"
      ],
      "red_stop": "jurisdiction_needed_is_dropped"
    },
    {
      "id": "source_posture",
      "allowed_values": [
        "ready",
        "partial",
        "source_needed",
        "review_needed",
        "stale",
        "revoked",
        "contradicted",
        "jurisdiction_needed",
        "local_only_private",
        "blocked"
      ],
      "red_stop": "non_ready_source_hashes_as_ready"
    },
    {
      "id": "selected_pack_set_fingerprint",
      "description": "Local digest of selected public Source Atlas pack ids and versions when applicable.",
      "red_stop": "pack_changes_do_not_change_replay_key"
    },
    {
      "id": "capability_context_branch",
      "description": "Local evidence branch from GoalIntentGeometry.",
      "red_stop": "same_raw_goal_across_different_local_evidence_hashes_the_same"
    },
    {
      "id": "local_context_version",
      "description": "Local version pointer for personalization slots, never raw values.",
      "red_stop": "raw_schedule_profile_or_proof_values_enter_fingerprint"
    },
    {
      "id": "privacy_class",
      "allowed_values": [
        "local_only",
        "local_user_context",
        "public_source_reference",
        "abstract_gap",
        "blocked"
      ],
      "red_stop": "privacy_boundary_changes_do_not_change_fingerprint"
    },
    {
      "id": "replay_comparison_policy",
      "description": "Rules for same-input replay, changed-input fork, and blocked-input replay refusal.",
      "red_stop": "replay_silently_reuses_stale_or_unsafe_route"
    },
    {
      "id": "audit",
      "description": "Local receipt metadata for inputs, excluded fields, digest version, and no-claim status.",
      "red_stop": "no_trace_for_fingerprint_construction"
    }
  ],
  "allowed_inputs_from_goal_intent_geometry": [
    "domain",
    "specific_domain",
    "goal_state",
    "deadline_semantics",
    "ambiguity_state",
    "risk_class",
    "jurisdiction_posture",
    "source_posture",
    "capability_context_branch",
    "operating_mode",
    "privacy_class"
  ],
  "forbidden_inputs": [
    "raw_private_goal_text",
    "exact_schedule",
    "private_proof_detail",
    "private_location_or_identifiers",
    "unredacted_collaborator_names",
    "raw_source_needed_narrative",
    "secret_or_credential_data",
    "support_bundle_data"
  ],
  "determinism_rules": {
    "same_canonical_inputs_same_schema_same_pack_set_same_context_version_same_privacy_class": "same_fingerprint",
    "material_route_input_change": "new_fingerprint_or_replay_comparison_fork",
    "fingerprint_scope": "local_replay_key_not_public_analytics_id",
    "raw_private_values_allowed": false
  },
  "fixture_obligations": {
    "minimum_raw_goal_fixtures": 50,
    "same_goal_different_person_families_minimum": 5,
    "must_prove_identical_canonical_inputs_produce_identical_fingerprints": true,
    "must_prove_materially_different_local_states_produce_different_fingerprints": true,
    "must_prove_no_raw_private_goal_text_in_fingerprint_material": true,
    "executable_corpus_created_by_this_issue": false
  },
  "downstream_consumers": [
    "AMB-695",
    "AMB-696",
    "AMB-697",
    "AMB-698",
    "AMB-699",
    "AMB-700",
    "AMB-701",
    "AMB-617",
    "AMB-619",
    "AMB-620",
    "AMB-623",
    "AMB-635"
  ],
  "red_conditions": [
    "fingerprint_includes_raw_private_goal_text_or_private_context",
    "fingerprint_computed_before_goal_intent_geometry",
    "same_canonical_input_produces_nondeterministic_fingerprints",
    "materially_different_local_user_states_produce_same_route_fingerprint",
    "source_ready_and_source_needed_states_hash_the_same",
    "high_risk_and_low_risk_states_hash_the_same",
    "hard_deadline_and_aspiration_date_hash_the_same",
    "selected_pack_set_changes_do_not_change_or_fork_the_fingerprint",
    "replay_silently_reuses_stale_or_unsafe_route",
    "fingerprint_treated_as_public_analytics_telemetry_r2_key_or_cross_user_identifier"
  ],
  "non_claims": [
    "app_source_change",
    "swift_implementation",
    "fingerprint_generator_implementation",
    "validator_automation",
    "executable_fixture_corpus",
    "runtime_path_selection",
    "generated_step_behavior",
    "replay_implementation",
    "source_pack_creation",
    "r2_write",
    "coverage_request_transport",
    "runtime_eligibility_computation",
    "ui_implementation",
    "accessibility_proof",
    "privacy_legal_approval",
    "release_readiness",
    "testflight_readiness",
    "app_store_readiness",
    "device_proof",
    "measured_performance_proof",
    "security_certification",
    "AMB-615_parent_completion"
  ]
}
