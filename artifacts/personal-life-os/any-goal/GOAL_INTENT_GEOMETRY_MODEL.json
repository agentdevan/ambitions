{
  "schema_version": 1,
  "artifact_id": "goal_intent_geometry_model",
  "linear_issue": "AMB-755",
  "parent_issue": "AMB-615",
  "plos_label": "PLOS-071",
  "status": "documentation_control_plane_contract",
  "implemented_in_app": false,
  "runtime_features_implemented": false,
  "required_upstream": [
    "GoalUnderstanding",
    "GoalStateAssessment",
    "OperatingMode",
    "SourceAuthorityState"
  ],
  "required_fields": [
    {
      "id": "geometry_id",
      "description": "Stable local id derived without exposing raw private text.",
      "red_stop": "id_contains_raw_goal_or_personal_context"
    },
    {
      "id": "normalized_intent",
      "description": "Short local semantic summary for routing only.",
      "red_stop": "summary_becomes_public_source_or_r2_material"
    },
    {
      "id": "domain",
      "description": "Broad domain family.",
      "red_stop": "unknown_domain_forced_into_generic_plan"
    },
    {
      "id": "specific_domain",
      "description": "Optional narrower local domain if explicit or source-supported.",
      "red_stop": "narrow_domain_inferred_from_stereotypes_or_weak_context"
    },
    {
      "id": "skill_slice",
      "allowed_values": [
        "beginner",
        "guided",
        "practiced",
        "expert_tracking",
        "collaborative_supported",
        "unknown"
      ],
      "red_stop": "beginner_or_expert_inferred_without_local_evidence"
    },
    {
      "id": "role",
      "allowed_values": [
        "owner",
        "learner",
        "caregiver",
        "collaborator",
        "dependent",
        "decision_maker",
        "maintainer",
        "unknown"
      ],
      "red_stop": "collaborative_or_dependent_context_collapsed_to_solo_task"
    },
    {
      "id": "risk_class",
      "description": "Safety, jurisdiction, and reversibility posture.",
      "red_stop": "high_risk_or_jurisdiction_needed_routes_as_ordinary_productivity"
    },
    {
      "id": "deadline_semantics",
      "allowed_values": [
        "hard_deadline",
        "target_date",
        "season",
        "rolling_window",
        "no_date_exploration",
        "recurring_maintenance",
        "unknown"
      ],
      "red_stop": "missing_deadline_silently_invented"
    },
    {
      "id": "ambiguity_state",
      "description": "Clear or missing domain, scope, resources, ownership, success definition, deadline, jurisdiction, or unsafe-to-infer state.",
      "red_stop": "ambiguity_bypassed_with_guessed_steps"
    },
    {
      "id": "capability_context_branch",
      "description": "Local evidence branch used for same-goal/different-person routing.",
      "red_stop": "same_raw_goal_always_maps_to_one_route"
    },
    {
      "id": "local_capability_evidence",
      "description": "Local-only evidence references.",
      "red_stop": "evidence_leaks_to_coverage_need_or_r2"
    },
    {
      "id": "source_posture",
      "allowed_values": [
        "ready",
        "partial",
        "source_needed",
        "review_needed",
        "stale",
        "revoked",
        "contradicted",
        "jurisdiction_needed",
        "local_only_private",
        "blocked"
      ],
      "red_stop": "non_ready_posture_produces_authoritative_steps"
    },
    {
      "id": "operating_mode",
      "description": "Required AMB-692 OperatingMode id.",
      "red_stop": "geometry_exists_without_operating_mode"
    },
    {
      "id": "goal_state_assessment",
      "description": "Required upstream assessment summary.",
      "red_stop": "goal_state_is_implicit_or_skipped"
    },
    {
      "id": "coverage_need_candidate",
      "description": "Optional abstract coverage need candidate with privacy class.",
      "red_stop": "raw_private_goal_text_becomes_coverage_demand"
    },
    {
      "id": "goal_shape_fingerprint_inputs",
      "description": "Non-private fields that AMB-694 may consume.",
      "red_stop": "fingerprint_consumes_raw_private_text_or_hidden_assumptions"
    },
    {
      "id": "privacy_class",
      "allowed_values": [
        "local_only",
        "local_user_context",
        "public_source_reference",
        "abstract_gap",
        "blocked"
      ],
      "red_stop": "public_or_r2_path_lacks_privacy_classification"
    },
    {
      "id": "audit",
      "description": "Local receipt metadata for inputs, assumptions, blocked fields, and no-claim status.",
      "red_stop": "no_trace_for_inferred_or_blocked_route"
    }
  ],
  "allowed_goal_shape_fingerprint_inputs": [
    "domain",
    "specific_domain",
    "goal_state",
    "deadline_semantics",
    "ambiguity_state",
    "risk_class",
    "jurisdiction_posture",
    "source_posture",
    "capability_context_branch",
    "operating_mode",
    "privacy_class"
  ],
  "forbidden_goal_shape_fingerprint_inputs": [
    "raw_private_goal_text",
    "exact_schedule",
    "private_proof_detail",
    "private_location_or_identifiers",
    "unredacted_collaborator_names",
    "raw_source_needed_narrative",
    "secret_or_credential_data"
  ],
  "coverage_need_rules": {
    "allowed_when_operating_modes_include": [
      "coverage_demand",
      "source_needed",
      "partial_source_backed"
    ],
    "must_be_abstract": true,
    "forbidden_payloads": [
      "raw_goal_text",
      "local_proof",
      "exact_schedule",
      "personal_names",
      "private_context"
    ]
  },
  "fixture_obligations": {
    "minimum_raw_goal_fixtures": 50,
    "operating_mode_coverage": "each_AMB-692_mode_at_least_twice",
    "same_goal_different_person_families_minimum": 5,
    "must_prove_same_goal_routes_differently_with_explicit_local_evidence": true,
    "must_prove_coverage_demand_excludes_raw_private_goal_text": true,
    "executable_corpus_created_by_this_issue": false
  },
  "downstream_consumers": [
    "AMB-694",
    "AMB-695",
    "AMB-696",
    "AMB-697",
    "AMB-698",
    "AMB-699",
    "AMB-700",
    "AMB-701",
    "AMB-617",
    "AMB-635"
  ],
  "red_conditions": [
    "raw_goal_text_goes_directly_to_step_list",
    "unsupported_or_source_needed_goal_gets_fake_plan",
    "coverage_demand_leaks_sensitive_intent_or_private_context",
    "same_raw_goal_collapses_to_one_generic_route_for_different_local_states",
    "beginner_expert_collaborator_caregiver_or_high_risk_state_inferred_without_explicit_evidence",
    "non_ready_source_posture_drives_ordinary_steps",
    "goal_shape_fingerprint_consumes_raw_private_text",
    "source_pack_r2_public_source_atlas_or_linear_receives_private_user_data"
  ],
  "non_claims": [
    "app_source_change",
    "swift_implementation",
    "classifier_implementation",
    "validator_automation",
    "executable_fixture_corpus",
    "goal_shape_fingerprint_implementation",
    "coverage_need_implementation",
    "runtime_path_selection",
    "generated_step_behavior",
    "source_pack_creation",
    "r2_write",
    "coverage_request_transport",
    "runtime_eligibility_computation",
    "ui_implementation",
    "accessibility_proof",
    "privacy_legal_approval",
    "release_readiness",
    "testflight_readiness",
    "app_store_readiness",
    "device_proof",
    "measured_performance_proof",
    "security_certification",
    "AMB-615_parent_completion"
  ]
}
