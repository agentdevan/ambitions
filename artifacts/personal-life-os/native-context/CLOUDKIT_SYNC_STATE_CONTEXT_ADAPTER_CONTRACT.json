{
  "schema_version": 1,
  "issue_id": "AMB-708",
  "plos_label": "PLOS-086",
  "parent_issue_id": "AMB-616",
  "artifact": "CloudKit Sync State Context Adapter Contract",
  "status": "documentation_control_plane_contract",
  "downstream_consumable": true,
  "source_kind": "cloudkit_sync_state",
  "core_rule": "CloudKit sync state is a bounded local trust explanation and fallback signal. It is not Source Atlas content R2 content release proof an account requirement a custom backend path or public proof.",
  "existing_source_anchors": [
    "Native/Ambitions/Persistence/SyncCapabilityContracts.swift",
    "Native/Ambitions/Persistence/CloudKitContinuityModels.swift",
    "Native/Ambitions/Persistence/CloudKitContinuityClient.swift",
    "Native/AmbitionsTests/Persistence/SyncCapabilityTests.swift",
    "Native/AmbitionsTests/Persistence/CloudKitContinuityFoundationTests.swift",
    "artifacts/personal-life-os/reports/PLOS-020-local-data-cloud-boundary.md",
    "artifacts/personal-life-os/reports/PLOS-021-cloudkit-schema-constraints.md",
    "artifacts/personal-life-os/native-context/NATIVE_CONTEXT_MESH_ADAPTER_CONTRACT.md"
  ],
  "non_claims": [
    "no_app_source_change",
    "no_swift_domain_implementation",
    "no_runtime_adapter_implementation",
    "no_cloudkit_environment_setup",
    "no_cloudkit_transport_implementation",
    "no_account_setup",
    "no_entitlement_change",
    "no_privacy_manifest_change",
    "no_runtime_sync_integration",
    "no_user_data_upload",
    "no_user_data_mutation",
    "no_conflict_ui",
    "no_delete_reset_export_propagation",
    "no_ui_implementation",
    "no_release_readiness",
    "no_accessibility_proof",
    "no_device_proof",
    "no_performance_proof",
    "no_r2_write",
    "no_source_atlas_publication"
  ],
  "adapter_required_fields": [
    "adapterId",
    "sourceKind",
    "permissionScope",
    "syncCapabilityRef",
    "permissionLedgerRef",
    "dataClass",
    "sensitivityClass",
    "slotTypes",
    "freshnessPolicy",
    "revocationPolicy",
    "allowedInfluence",
    "storageBoundary",
    "receiptPolicy",
    "fallbackBehavior",
    "blockedUses"
  ],
  "slot_types": [
    "sync_local_only_unavailable",
    "sync_disabled",
    "sync_account_unavailable",
    "sync_restricted",
    "sync_temporarily_unavailable",
    "sync_paused_by_user",
    "sync_needs_review",
    "sync_healthy_after_proof"
  ],
  "state_mapping": [
    {
      "source_state": "localOnlyUnavailable",
      "slot": "sync_local_only_unavailable",
      "behavior": "local_only_operation_remains_normal_do_not_request_account_setup"
    },
    {
      "source_state": "disabled",
      "slot": "sync_disabled",
      "behavior": "respect_disabled_state_and_record_rollback_control_detail"
    },
    {
      "source_state": "accountUnavailable",
      "slot": "sync_account_unavailable",
      "behavior": "keep_local_data_authoritative_and_explain_no_cross_device_assumption"
    },
    {
      "source_state": "restricted",
      "slot": "sync_restricted",
      "behavior": "keep_local_operation_available_surface_review_only_where_relevant"
    },
    {
      "source_state": "temporarilyUnavailable",
      "slot": "sync_temporarily_unavailable",
      "behavior": "use_local_queue_fallback_posture_no_panic_or_shame_language"
    },
    {
      "source_state": "paused",
      "slot": "sync_paused_by_user",
      "behavior": "stop_current_sync_influence_until_user_resumes"
    },
    {
      "source_state": "needsReview",
      "slot": "sync_needs_review",
      "behavior": "hold_sync_dependent_behavior_behind_review_proof"
    },
    {
      "source_state": "healthyAfterProof",
      "slot": "sync_healthy_after_proof",
      "behavior": "permit_only_exact_proven_sync_explanation_do_not_generalize_to_release_readiness"
    }
  ],
  "context_to_path_matrix": [
    {
      "signal": "local_only_or_unavailable_sync",
      "may_influence": ["fallback_explanation", "local_receipt_copy", "cross_device_affordance_disabled_state", "export_delete_reminder"],
      "must_not_influence": ["recommended_step_quality", "source_authority", "schedule_install", "step_graph", "high_risk_routing", "public_sharing"]
    },
    {
      "signal": "account_unavailable_or_restricted",
      "may_influence": ["conflict_review_posture", "local_only_continuity_explanation", "user_control_surface"],
      "must_not_influence": ["blocking_local_planning", "account_requirement", "shame_or_urgency_pressure"]
    },
    {
      "signal": "temporarily_unavailable",
      "may_influence": ["retry_backoff_explanation", "local_outbox_count_warning", "last_local_success_trust_detail"],
      "must_not_influence": ["hidden_retries_that_mutate_data", "lost_data_claim_without_proof", "readiness_claim"]
    },
    {
      "signal": "paused_by_user",
      "may_influence": ["respect_pause", "stop_sync_derived_trust_messaging", "local_only_authority"],
      "must_not_influence": ["stale_cross_device_assumption", "hidden_reenable", "nagging"]
    },
    {
      "signal": "needs_review",
      "may_influence": ["trust_glyph_detail", "conflict_review_queue", "hold_sync_current_claims"],
      "must_not_influence": ["remote_state_authority", "automatic_conflict_resolution", "release_proof"]
    },
    {
      "signal": "healthy_after_proof",
      "may_influence": ["narrow_cross_device_continuity_explanation_for_exact_proven_family_path"],
      "must_not_influence": ["app_store_sync_readiness", "m23_completion", "m26_certification", "private_data_in_r2_source_atlas"]
    }
  ],
  "privacy_boundary": {
    "allowed_local_summaries": [
      "sync_mode",
      "sync_state",
      "feature_flag_state",
      "account_status_category",
      "proof_verified_boolean",
      "user_paused_boolean",
      "local_only_fallback_state",
      "local_operation_blocked_boolean",
      "writes_user_data_boolean",
      "user_data_captured_boolean",
      "redacted_pending_review_counts",
      "local_receipt_or_ledger_refs",
      "rollback_detail"
    ],
    "blocked_raw_material": [
      "cloudkit_record_payloads",
      "raw_goals_steps_captures_proof_receipts_local_learning_preferences_tombstones_sync_ledger_payloads",
      "private_record_names",
      "external_device_identifiers",
      "account_identifiers",
      "conflict_payload_bodies",
      "private_outbox_entries",
      "raw_error_logs_with_user_data_or_secrets"
    ],
    "forbidden_destinations": [
      "r2_objects",
      "public_source_atlas_packs_seeds_claims_requirements_pathing_data_manifests_release_receipts_validation_reports",
      "linear_private_sync_payload_details",
      "unredacted_support_bundles_or_diagnostics",
      "external_prompts_or_hosted_inference_context",
      "analytics_telemetry_crash_engagement_payloads",
      "public_share_progress_story_artifacts",
      "screenshots_or_visual_proof_with_private_sync_account_data"
    ]
  },
  "ledger_events": [
    "sync_offered_after_value_proof",
    "sync_enabled",
    "sync_disabled",
    "sync_paused",
    "sync_resumed",
    "account_unavailable",
    "account_restricted",
    "temporarily_unavailable",
    "needs_review",
    "proof_verified_for_specific_path_family",
    "conflict_review_opened",
    "local_fallback_activated",
    "delete_reset_export_pending_sync_propagation",
    "rollback_to_local_only"
  ],
  "fixture_matrix": [
    "feature_flag_off_emits_local_only_unavailable_slot",
    "disabled_state_keeps_local_operation_authoritative",
    "no_icloud_account_emits_account_unavailable_fallback_without_blocking_planning",
    "restricted_account_emits_restricted_fallback_without_retry_pressure",
    "temporary_unavailability_emits_retry_degraded_explanation_without_local_write_failure",
    "user_pause_invalidates_current_sync_influence",
    "unknown_or_available_without_proof_maps_to_needs_review",
    "healthy_after_proof_remains_scoped_and_does_not_claim_release_readiness",
    "stale_healthy_proof_degrades_to_needs_review",
    "conflict_review_blocks_remote_authority_but_not_local_use",
    "pending_outbox_count_is_local_redacted_and_not_public_proof",
    "delete_reset_export_pending_propagation_does_not_resurrect_data",
    "sync_state_never_enters_source_atlas_r2_linear_private_detail_support_bundle_external_prompt_analytics_telemetry_crash_or_public_share_artifact",
    "fixture_test_generated_sync_states_are_not_production_runtime_proof"
  ],
  "red_conditions": [
