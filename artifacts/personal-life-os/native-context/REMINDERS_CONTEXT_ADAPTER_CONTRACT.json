    ],
    "forbidden_destinations": [
      "r2_objects",
      "source_atlas_packs",
      "public_pathing_data",
      "linear_private_reminder_content",
      "unredacted_support_bundle",
      "external_model_prompt",
      "analytics_or_telemetry_payload"
    ]
  },
  "fixture_matrix": [
    "not_determined_write_shows_value_proof_before_system_prompt",
    "denied_write_leaves_step_and_local_ambitions_reminder_usable",
    "restricted_write_explains_reduced_external_continuity_without_nagging",
    "granted_write_creates_only_user_confirmed_apple_reminders_item_and_local_receipt",
