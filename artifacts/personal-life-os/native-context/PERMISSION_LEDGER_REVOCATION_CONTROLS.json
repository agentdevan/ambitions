  "revocation_controls": [
    {
      "trigger": "permission_denied",
      "required_behavior": "record_denied_clear_pending_prompt_keep_app_usable",
      "fallback": "baseline_manual_context"
    },
    {
      "trigger": "permission_canceled",
      "required_behavior": "record_canceled_do_not_nag_do_not_infer_denial",
      "fallback": "baseline_manual_context"
    },
    {
      "trigger": "permission_restricted",
      "required_behavior": "record_restricted_expose_review_state_avoid_retry_loops",
      "fallback": "baseline_or_needs_review"
    },
    {
      "trigger": "permission_revoked",
      "required_behavior": "record_revoked_invalidate_context_slots_require_fresh_value_proof_before_re_request",
      "fallback": "baseline_manual_with_receipt_explanation"
    },
    {
      "trigger": "permission_paused",
      "required_behavior": "record_paused_stop_sync_or_control_influence_preserve_local_authority",
      "fallback": "local_only_operation"
    },
    {
      "trigger": "permission_unavailable",
      "required_behavior": "record_unavailable_avoid_account_or_setup_pressure",
      "fallback": "local_only_fallback"
    },
    {
      "trigger": "permission_scope_changed",
      "required_behavior": "record_scope_changed_invalidate_broader_prior_influence_keep_new_allowed_scope_only",
      "fallback": "exact_scope_slots_only"
    },
    {
      "trigger": "permission_stale",
      "required_behavior": "record_stale_or_needs_review_hold_meaningful_influence",
      "fallback": "needs_review_or_baseline"
    }
  ],
  "context_to_path_influence": [
    {
      "sourceKind": "calendar",
