{
  "schema_version": 1,
  "program": "plos",
  "owning_issue": "AMB-688",
  "parent_issue": "AMB-614",
  "label": "PLOS-062",
  "contract": "SourceApplicabilityEnvelope",
  "non_claims": [
    "no app source change",
    "no Swift runtime implementation",
    "no runtime eligibility computation in app",
    "no runtime pack consumption",
    "no UI implementation",
    "no production R2 write",
    "no production promotion",
    "no privacy/legal/release/accessibility/device/performance/security certification proof"
  ],
  "required_field_groups": [
    "identity",
    "source_binding",
    "temporal",
    "jurisdiction",
    "risk_and_review",
    "manifest_controls",
    "privacy_boundary",
    "allowed_actions",
    "blocking_reasons"
  ],
  "computed_runtime_eligibility_outputs": [
    "eligible",
    "candidate",
    "not_eligible",
    "blocked",
    "not_public_eligible"
  ],
  "runtime_action_matrix": [
    {"computed_state": "eligible", "recommended_step_allowed": "future_runtime_only_after_M10_proof", "schedule_install_allowed": "future_runtime_only_after_M10_proof", "share_projection_allowed": "only_if_privacy_share_boundary_passes", "source_settings_display_allowed": true, "local_personalization_allowed": "when_local_privacy_passes"},
    {"computed_state": "candidate", "recommended_step_allowed": false, "schedule_install_allowed": false, "share_projection_allowed": false, "source_settings_display_allowed": true, "local_personalization_allowed": "local_only_if_safe"},
    {"computed_state": "not_eligible", "recommended_step_allowed": false, "schedule_install_allowed": false, "share_projection_allowed": false, "source_settings_display_allowed": true, "local_personalization_allowed": "local_only_if_safe"},
    {"computed_state": "blocked", "recommended_step_allowed": false, "schedule_install_allowed": false, "share_projection_allowed": false, "source_settings_display_allowed": true, "local_personalization_allowed": false},
    {"computed_state": "not_public_eligible", "recommended_step_allowed": "no_public_source_backed_action", "schedule_install_allowed": "no_public_source_backed_action", "share_projection_allowed": false, "source_settings_display_allowed": true, "local_personalization_allowed": "user_owned_local_only_if_safe"}
  ],
  "fixtures": [
    {"id": "ready_candidate_all_evidence_present", "source_authority_state": "eligible_current", "user_state": "ready", "inputs": ["source_bound", "hashes_match", "fresh", "not_revoked", "not_contradicted", "risk_reviewed", "jurisdiction_resolved", "release_receipt_present", "rollback_present", "compatible", "privacy_scan_pass"], "computed_state": "candidate", "runtime_actions": "no_until_future_runtime_proof"},
    {"id": "missing_source", "source_authority_state": "source_needed", "user_state": "needs_source", "inputs": ["source_missing"], "computed_state": "not_eligible", "route": "source_needed"},
    {"id": "review_needed", "source_authority_state": "review_needed", "user_state": "needs_review", "inputs": ["review_required", "review_missing"], "computed_state": "not_eligible", "route": "review_needed"},
    {"id": "jurisdiction_needed", "source_authority_state": "jurisdiction_needed", "user_state": "needs_review", "inputs": ["jurisdiction_required", "jurisdiction_missing"], "computed_state": "not_eligible", "route": "jurisdiction_needed"},
    {"id": "stale_source", "source_authority_state": "stale", "user_state": "older_source", "inputs": ["freshness_stale"], "computed_state": "not_eligible", "route": "source_needed_or_review_needed"},
    {"id": "hard_expired_source", "source_authority_state": "stale_critical", "user_state": "cannot_use", "inputs": ["hard_expires_at_passed"], "computed_state": "blocked", "route": "blocked_until_refreshed"},
    {"id": "source_changed", "source_authority_state": "source_changed", "user_state": "source_changed", "inputs": ["source_hash_changed"], "computed_state": "not_eligible", "route": "review_source_change"},
    {"id": "contradicted_claim", "source_authority_state": "contradicted", "user_state": "cannot_use", "inputs": ["contradiction_unresolved"], "computed_state": "blocked", "route": "contradiction_review"},
    {"id": "revoked_pack", "source_authority_state": "revoked", "user_state": "cannot_use", "inputs": ["revocation_match"], "computed_state": "blocked", "route": "revoke_quarantine_rollback"},
    {"id": "incompatible_manifest", "source_authority_state": "incompatible", "user_state": "cannot_use", "inputs": ["compatibility_failed"], "computed_state": "blocked", "route": "compatibility_fallback"},
    {"id": "high_risk_reviewed", "source_authority_state": "eligible_current", "user_state": "ready", "inputs": ["high_risk", "review_approved", "jurisdiction_resolved", "fresh", "not_revoked", "release_receipt_present", "rollback_present", "compatible", "privacy_scan_pass"], "computed_state": "candidate", "runtime_actions": "no_until_future_runtime_proof"},
    {"id": "high_risk_unreviewed", "source_authority_state": "high_risk_review_needed", "user_state": "cannot_use", "inputs": ["high_risk", "review_missing"], "computed_state": "blocked", "route": "high_risk_review"},
    {"id": "local_only_private", "source_authority_state": "local_only_private", "user_state": "local_only", "inputs": ["local_only", "private_user_owned"], "computed_state": "not_public_eligible", "route": "local_only"},
    {"id": "private_data_leak", "source_authority_state": "quarantined", "user_state": "cannot_use", "inputs": ["private_data_scan_failed"], "computed_state": "blocked", "route": "quarantine"},
    {"id": "missing_rollback", "source_authority_state": "review_needed", "user_state": "needs_review", "inputs": ["release_receipt_present", "rollback_missing"], "computed_state": "not_eligible", "route": "review_needed"},
    {"id": "missing_release_receipt", "source_authority_state": "review_needed", "user_state": "needs_review", "inputs": ["release_receipt_missing"], "computed_state": "not_eligible", "route": "review_needed"},
    {"id": "unsupported_schema", "source_authority_state": "incompatible", "user_state": "cannot_use", "inputs": ["unsupported_schema"], "computed_state": "blocked", "route": "compatibility_fallback"}
  ],
  "red_conditions": [
    "manual_runtime_eligible_assertion",
    "stale_revoked_contradicted_or_incompatible_material_drives_steps",
    "jurisdiction_sensitive_material_treated_as_global",
    "high_risk_material_lacks_risk_jurisdiction_review_or_freshness_metadata",
    "private_user_data_or_secrets_in_public_source_atlas_or_r2_material",
    "fixture_or_generated_asset_treated_as_production_runtime_proof"
  ]
}
