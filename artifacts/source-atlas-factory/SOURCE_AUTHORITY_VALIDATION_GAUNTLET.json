    "source_binding",
    "schema_and_compatibility",
    "integrity",
    "freshness_and_revocation",
    "contradiction",
    "applicability",
    "risk_and_review",
    "privacy_boundary",
    "release_and_rollback",
    "hardcoded_step_safety",
    "user_facing_compression",
    "non_ready_routing",
    "source_settings_drill_down",
    "runtime_action_gate"
  ],
  "future_outputs": [
    "SourceAuthorityValidationResult",
    "SourceAuthorityValidationFixture",
    "SourceAuthorityValidationReceipt",
    "SourceAuthorityReplayFingerprint"
  ],
