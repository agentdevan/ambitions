  "label": "PLOS-065",
  "contract": "SourceAuthorityValidationGauntlet",
  "non_claims": [
    "no app source change",
    "no Swift runtime implementation",
    "no validator automation",
    "no executable test harness",
    "no runtime eligibility computation in app",
    "no runtime pack consumption",
    "no UI implementation",
    "no production R2 write",
    "no privacy/legal/release/accessibility/device/performance/security certification proof"
