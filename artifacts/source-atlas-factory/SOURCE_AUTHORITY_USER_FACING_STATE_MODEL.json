  "label": "PLOS-061",
  "contract": "SourceAuthorityUserState compressed user-facing state model",
  "non_claims": [
    "no app source change",
    "no Swift runtime implementation",
    "no UI implementation",
    "no screenshot proof",
    "no accessibility proof",
    "no runtime eligibility computation in app",
    "no runtime pack consumption",
    "no production R2 write",
    "no production promotion",
    "no privacy/legal/release/accessibility/device/performance/security certification proof"
  ],
  "states": [
    {
      "id": "ready",
      "label": "Ready",
      "top_level_meaning": "Source authority is current enough for the scoped action, subject to future computed eligibility proof.",
      "drill_down": "source_freshness_review_receipt_risk_jurisdiction_rollback",
      "may_drive_runtime": "only_after_future_computed_runtime_eligibility_proof"
    },
    {
      "id": "needs_source",
      "label": "Needs source",
      "top_level_meaning": "Ambitions does not have enough source backing for this path.",
      "drill_down": "missing_source_or_coverage_gap",
      "may_drive_runtime": "no"
    },
    {
      "id": "needs_review",
      "label": "Needs review",
      "top_level_meaning": "A source, jurisdiction, risk, freshness, or review condition must be checked before planning or sharing.",
      "drill_down": "source_settings_review_details",
      "may_drive_runtime": "no"
    },
    {
      "id": "older_source",
      "label": "Older source",
      "top_level_meaning": "Source authority is stale or may be stale; current use is not Green.",
      "drill_down": "freshness_expiration_replacement",
      "may_drive_runtime": "no"
    },
    {
      "id": "source_changed",
      "label": "Source changed",
      "top_level_meaning": "A source or claim changed since last safe use.",
      "drill_down": "changed_source_trace_and_review",
      "may_drive_runtime": "no"
    },
    {
      "id": "cannot_use",
      "label": "Cannot use this",
      "top_level_meaning": "Source authority is blocked, revoked, contradicted, incompatible, high-risk unreviewed, or quarantined.",
      "drill_down": "blocker_reason_and_safe_fallback",
      "may_drive_runtime": "no"
    },
    {
      "id": "local_only",
      "label": "Local only",
      "top_level_meaning": "This material is user-owned/private and cannot become public Source Atlas authority.",
      "drill_down": "local_privacy_and_receipt_boundary",
      "may_drive_runtime": "local_only_future_policy"
    }
  ],
  "internal_state_mapping": [
    {"source_authority_state": "unknown", "user_state": "needs_source", "runtime_eligibility": "not_eligible"},
    {"source_authority_state": "source_needed", "user_state": "needs_source", "runtime_eligibility": "not_eligible"},
