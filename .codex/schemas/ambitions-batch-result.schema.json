{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.local/schemas/ambitions-batch-result.schema.json",
  "title": "Ambitions Codex OS Batch Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "status",
    "summary",
    "changed_files",
    "validations_run",
    "no_cost_proof",
    "source_truth",
    "risks",
    "rollback",
    "next_recommended_batch"
  ],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["GREEN", "YELLOW", "RED"]},
    "summary": {"type": "string", "minLength": 1},
    "changed_files": {"type": "array", "items": {"type": "string"}, "default": []},
    "validations_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "evidence"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail", "warn", "skip"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "no_cost_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_dependencies_added", "api_keys_added", "network_or_ci_added", "paid_services_added", "notes"],
      "properties": {
        "new_dependencies_added": {"type": "boolean"},
        "api_keys_added": {"type": "boolean"},
        "network_or_ci_added": {"type": "boolean"},
        "paid_services_added": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "source_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_truth_files", "supporting_files", "uncertainties"],
      "properties": {
        "active_truth_files": {"type": "array", "items": {"type": "string"}},
        "supporting_files": {"type": "array", "items": {"type": "string"}},
        "uncertainties": {"type": "array", "items": {"type": "string"}}
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "array", "items": {"type": "string"}},
    "next_recommended_batch": {"type": "string"}
  }
}
