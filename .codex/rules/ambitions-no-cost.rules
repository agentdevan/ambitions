# Ambitions no-cost and command policy.
# These are repo-local guardrails and are not a substitute for validator checks.

## Intent map
#
# allow: normal local maintenance/validation commands
# prompt: commands that may pass with explicit intent or approval in normal sessions
# forbid: commands that should not be run in this batch and should be blocked by hooks
#
# Starlark-style examples:
# allow:
#   prefix_rule(pattern=["git", "status"], decision="allow")
#   prefix_rule(pattern=["make", "ambitions-codex-os-validate"], decision="allow")
# prompt:
#   prefix_rule(pattern=["git", "add"], decision="prompt")
#   prefix_rule(pattern=["xcodebuild"], decision="prompt")
# forbid:
#   prefix_rule(pattern=["npm", "install"], decision="forbidden")
#   prefix_rule(pattern=["xcodebuild", "archive"], decision="forbidden")

# Allowed commands
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["python3", "scripts/ambitions-codex-os-validate.py"], decision="allow")
prefix_rule(pattern=["python3", "scripts/ambitions-codex-os-doctor.py"], decision="allow")
prefix_rule(pattern=["make", "ambitions-codex-os-validate"], decision="allow")
prefix_rule(pattern=["make", "ambitions-codex-os-doctor"], decision="allow")

# Prompt families
prefix_rule(pattern=["git", "add"], decision="prompt")
prefix_rule(pattern=["git", "commit"], decision="prompt")
prefix_rule(pattern=["chmod"], decision="prompt")
prefix_rule(pattern=["make", "batch"], decision="prompt")
prefix_rule(pattern=["xcodebuild"], decision="prompt")
prefix_rule(pattern=["python3", "scripts/ambitions-codex-train.sh"], decision="prompt")

# Forbidden examples
# Use prompt/forbid intent separation in docs and validator.
prefix_rule(pattern=["git", "push"], decision="forbidden")
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden")
prefix_rule(pattern=["git", "clean", "-fdx"], decision="forbidden")
prefix_rule(pattern=["rm", "-rf"], decision="forbidden")
prefix_rule(pattern=["gh", "workflow"], decision="forbidden")
prefix_rule(pattern=["gh", "run"], decision="forbidden")
prefix_rule(pattern=["gh", "pr", "merge"], decision="forbidden")
prefix_rule(pattern=["npm", "install"], decision="forbidden")
prefix_rule(pattern=["npm", "i"], decision="forbidden")
prefix_rule(pattern=["pnpm", "install"], decision="forbidden")
prefix_rule(pattern=["yarn", "install"], decision="forbidden")
prefix_rule(pattern=["pip", "install"], decision="forbidden")
prefix_rule(pattern=["brew", "install"], decision="forbidden")
prefix_rule(pattern=["curl"], decision="forbidden")
prefix_rule(pattern=["wget"], decision="forbidden")
prefix_rule(pattern=["security"], decision="forbidden")
prefix_rule(pattern=["xcrun", "altool"], decision="forbidden")
prefix_rule(pattern=["xcrun", "notarytool"], decision="forbidden")
prefix_rule(pattern=["xcodebuild", "archive"], decision="forbidden")

# Representative match / not_match intent examples
# allow match: `codex execpolicy check --rules .codex/rules/ambitions-no-cost.rules git status`
# prompt match: `codex execpolicy check --rules .codex/rules/ambitions-no-cost.rules xcodebuild test`
# forbidden match: `codex execpolicy check --rules .codex/rules/ambitions-no-cost.rules git push`
# not_match example: `curl https://example.com` must not resolve to allow or prompt.
