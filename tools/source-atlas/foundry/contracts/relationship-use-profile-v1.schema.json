{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitions.app/schemas/source-atlas/relationship-use-profile-v1.schema.json",
  "title": "Relationship Use Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "profileId",
    "revision",
    "mappingSetClasses",
    "allowedPurposes",
    "allowedDirections",
    "requiredReviewStates",
    "requiredEndpointStates",
    "allowedRightsStates",
    "forbiddenPropagation",
    "nonClaims",
    "inferencePolicy",
    "expiresAt",
    "inspectionOnlyPurposes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "relationship-use-profile-v1"
    },
    "kind": {
      "const": "relationshipUseProfile"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mappingSetClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "cip_edition_migration",
          "cip_soc_relevance",
          "onet_soc_relationship",
          "onet_esco_mapping",
          "publisher_alignment",
          "mapping_candidate"
        ]
      },
      "uniqueItems": true
    },
    "allowedPurposes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/purpose"
      },
      "uniqueItems": true
    },
    "allowedDirections": {
      "type": "array",
      "items": {
        "enum": [
          "subject_to_object",
          "object_to_subject"
        ]
      },
      "uniqueItems": true
    },
    "requiredReviewStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "source_published",
          "approved",
          "restricted",
          "explicit_no_match"
        ]
      },
      "uniqueItems": true
    },
    "requiredEndpointStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "current_for_mapping",
          "newer_than_mapping",
          "changed",
          "split",
          "merged",
          "deprecated",
          "deleted",
          "unavailable"
        ]
      },
      "uniqueItems": true
    },
    "allowedRightsStates": {
      "type": "array",
      "items": {
        "enum": [
          "approved",
          "attribution_required",
          "transformation_restricted",
          "inspection_only"
        ]
      },
      "uniqueItems": true
    },
    "forbiddenPropagation": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/forbidden"
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "chain_inference"
          }
        },
        {
          "contains": {
            "const": "inverse_inference"
          }
        },
        {
          "contains": {
            "const": "claim_transfer"
          }
        },
        {
          "contains": {
            "const": "unrelated_claim_families"
          }
        },
        {
          "contains": {
            "const": "qualification"
          }
        },
        {
          "contains": {
            "const": "credit"
          }
        },
        {
          "contains": {
            "const": "acceptance"
          }
        },
        {
          "contains": {
            "const": "user_capability"
          }
        }
      ]
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "inferencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "transitive",
        "inverse",
        "symmetric",
        "claimPropagation"
      ],
      "properties": {
        "chain": {
          "const": "forbidden"
        },
        "transitive": {
          "const": "forbidden"
        },
        "inverse": {
          "const": "stored_edge_only"
        },
        "symmetric": {
          "const": "stored_edge_only"
        },
        "claimPropagation": {
          "const": "forbidden"
        }
      }
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "inspectionOnlyPurposes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/purpose"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "purpose": {
      "enum": [
        "inspection",
        "search_expansion",
        "destination_discovery",
        "explanation",
        "source_overlay_join",
        "version_migration",
        "review_only",
        "unavailable"
