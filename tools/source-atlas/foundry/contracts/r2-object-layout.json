{
  "dataClass": "public_r2_object_key",
  "forbiddenSegments": [
    "account",
    "user",
    "goal",
    "capture",
    "schedule",
    "life-capital",
    "proof",
    "receipt-payload",
    "private",
    "personalization"
  ],
  "kind": "ambitions.sourceAtlas.r2ObjectLayout",
  "nonClaims": [
    "not a private user-data backend",
    "not private life graph storage",
    "not an official legal, medical, financial, or admissions decision",
    "not runtime recommendation proof by itself",
    "not R2 release readiness",
    "not accessibility, privacy, or legal approval"
  ],
  "objects": [
    "source-atlas/v1/releases/<version>/manifest.json",
    "source-atlas/v1/releases/<version>/packs/<pack>.json",
    "source-atlas/v1/releases/<version>/schemas/<schema>.json",
    "source-atlas/v1/releases/<version>/shards/<shard>.json",
    "source-atlas/v1/releases/<version>/registries/<registry>.json",
    "source-atlas/v1/releases/<version>/provenance/<receipt>.json",
    "source-atlas/v1/releases/<version>/freshness-manifest.json",
    "source-atlas/v1/channels/staging/manifest.json",
    "source-atlas/v1/channels/stable/manifest.json",
    "source-atlas/v1/revocations/<version>.json",
    "source-atlas/v1/last-known-good/<channel>.json"
  ],
  "prefix": "source-atlas/v1",
  "privacyBoundary": "public/reference/freshness only; no private life graph, goals, captures, calendar data, proof, receipts, personalization, behavior history, or private user context",
  "publicReferenceOnly": true,
  "schemaVersion": 1
}
