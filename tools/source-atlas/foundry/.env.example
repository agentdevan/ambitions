# Source Atlas Foundry local configuration.
# Copy to tools/source-atlas/foundry/.env or export these in your shell.
# Do not commit real keys.

# Shared api.data.gov key used by Data.gov and, as fallback, College Scorecard.
DATAGOV_API_KEY=your_api_data_gov_key_here

# Optional dedicated College Scorecard key. If absent, DATAGOV_API_KEY is used.
COLLEGE_SCORECARD_API_KEY=your_college_scorecard_api_key_here

# Required only for USAJOBS Search API harvests.
USAJOBS_USER_AGENT=you@example.com
USAJOBS_AUTHORIZATION_KEY=your_usajobs_authorization_key_here

# Optional fetch tuning for large public datasets such as O*NET.
SOURCE_ATLAS_USER_AGENT=AmbitionsSourceAtlasFoundry/1.0 public-reference-only
SOURCE_ATLAS_FETCH_TIMEOUT_SECONDS=120
SOURCE_ATLAS_FETCH_RETRIES=3

# Optional Cloudflare/Wrangler noninteractive auth.
# Wrangler OAuth is already fine for local use; prefer a scoped token only for automation.
# Optional R2 S3-compatible credentials for AWS CLI, rclone, or future bulk sync.
# Current Foundry Wrangler uploads do not require these when Wrangler OAuth or CLOUDFLARE_API_TOKEN is used.
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_token_here
