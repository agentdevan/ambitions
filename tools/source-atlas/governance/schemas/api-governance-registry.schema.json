{
  "$id": "ambitions.sourceAtlas.apiGovernanceRegistry.schema.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "api_policies": {
      "items": {
        "required": [
