          "source_id",
          "api_mode",
          "key_required",
          "env_var_name",
          "missing_key_behavior",
          "rate_limit_per_second",
          "rate_limit_per_minute",
          "daily_budget_limit",
          "monthly_budget_limit",
          "max_records_per_run",
          "max_pages_per_run",
          "timeout_seconds",
          "retry_policy",
          "backoff_policy",
          "circuit_breaker_policy",
