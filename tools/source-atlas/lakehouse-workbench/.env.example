# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=ambitions-source-atlas-staging

# Local candidate run directory.
# Defaults to output/source-atlas/lakehouse-runs under the repo.
# AMBITIONS_SOURCE_ATLAS_RUNS_DIR=/absolute/local/path
